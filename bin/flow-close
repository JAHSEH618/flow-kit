#!/bin/sh
# flow-close —— 编排方的核对与收口一键(四种模式)。
#   默认(轮收工):§B5 冻结核对 + 非空转 + 交付态哈希 + 账本 lint + 文档预算 + 规则书棘轮。
#   --between(轮间交接口):交付态哈希 + 冻结核对 + 非空转 + 假话门(0.9.0)+ 越面(0.9.0,--face)+ 树读数 + 路由复跑 + REQ 对账 + 文档预算。(flow-round close 按约定名调它)
#       REQ 对账拿到 RC=3(TRACE N/A,本仓 plan 不写 REQ 行)印 info 不判红 —— 「不适用」与「不达标」不许同型(0.7.1)。
#   --wrap(收口机械段,0.6.0;步序 0.8.2 调过):交付态哈希 → manifest verify → 非空转 → 假话门(**以上四条先核树**)
#       → 三态表 dry-run → 账本 lint → REQ 对账 →(对账绿才动树)索引重渲 + REQ 翻 done → 门整跑(收口那一次;末尾印一行可照抄的门读数)
#       → 文档预算 → 规则书棘轮 → 轮数账 --write → 状态档事实段;末行 WRAP OK 之后印剩余手工步清单(编排方不必再读 close-block.md)。
#       病根:收口十步里的机械步曾各占编排方一个请求(ShipLedger 收口 ≈60 min、StockSteer 20+27 min);这里一条命令、一行末行。
#       判断步(账本 diff 审、spec 落地记录、根文档读数、commit 消息)仍归编排方 —— 它们不是机械的。
#       ⚠ --plan 给了就会改 plan 文件(翻 REQ 状态):它必须在编排方的申报清单里,否则 verify 会红「漏申报」;
#         而它在清单里**也会**因为被改而让交付态哈希红 —— 所以 0.8.2 起交付态三条排在两个写手之前,核完树再动树。
#   --ship(收口提交后,0.6.0):clear-map-debt → **队列落笔** → push dev → gh pr create → flow-pr-merge --background,一条命令四个请求;
#       队列落笔(0.8.1):clear-map-debt 只写工作树,而下一步直接 push ⟹ 中间零提交,队列的清空**按定义**进不了本批自己的 PR
#         (P2-2 那次没暴露,只因为下一批的合并比人快)。这里按 pathspec 单独落一笔,不扫工作树里的其它脏东西,
#         也不 amend $COMMIT —— 后面 is-ancestor 那条判据仍判的是收口 commit 本身。
#       --dir <流程目录>(0.7.0)末尾重跑 flow-usage --write:轮数账的窗延到收口末(commit / push / PR 都进账;p4e 实测旧窗只盖住编排方 46% 的请求)。
# 病根:轮间那套一直是手拼 5–7 条命令、每批 4 次(实测 ≈28 min/批,占编排固定开销的三分之一),
#   而手拼时 RC 隔着管道取、判据进 && 链 —— 正是 §J 那两条硬规矩最常破的地方。
# 用法: flow-close <流程目录(绝对)> <基线文件(绝对)> <申报清单(绝对)> [after-hashes(绝对)]
#       flow-close --between <流程目录(绝对)> <基线(绝对)> <申报清单(绝对)> <after-hashes(绝对)> [--task <任务号>] [--plan <plan绝对>] [--face <.face-<轮名>.txt 绝对>]
#         --task 给了才跑路由复跑(按申报清单里的路径),--task + --plan 都给了才跑 flow-trace;--face 给了才判越面(flow-round close 按约定名传)。
#       flow-close --wrap <流程目录(绝对)> <基线(绝对)> <申报清单(绝对)> [after-hashes(绝对)] [--task <号>] [--plan <plan绝对>] [--verdicts <三态表绝对>]
#       flow-close --ship <commit> --subject <PR 标题> [--verdicts <三态表绝对>] [--dir <流程目录绝对>]
# 逐项打印 RC;任一红 ⟹ 末行 `ROUND-CLOSE RED` / `BETWEEN RED` / `WRAP RED` 且 RC=1;全绿 ⟹ `… OK`。--ship 末行 `SHIP OK: PR #N …` / `SHIP RED`。
#   flow-doc-budget 的 WARN 不算红(它是仪表盘)。
# 非空转:抽的行必须真在实改集里(先 tracked 轴,空则 ignored 轴与基线比 sha);抽不在实改集里的行永远不红 —— 那不是非空转,是空转。
# 规则书棘轮:FLOW_LOCAL_DOC **字节**记在 FLOW_FLOW_DIR/.rulebook-bytes,只许降(变长 = RED);行数超 FLOW_DOC_BUDGET_RULEBOOK 也 RED。
#   0.8.3 把单位从行换成字节:实录一族一行、族内用 ` · ` 串子句(flow-rulebook retire N.k),退一条子句行数纹丝不动 ⟹ 旧单位量不到退役,退与不退同读数。
#   遇到旧的 .rulebook-lines:先按**旧单位**判一次(换单位不许洗掉一次变长),不红才打字节新基线并删旧件,两个方向的读数都印出来(协议 §J 门定义变了要重打基线)。
# 读的配置:FLOW_REPO_DIR FLOW_LOCAL_DOC_PATH FLOW_FLOW_DIR_PATH FLOW_DOC_BUDGET_RULEBOOK FLOW_FACT_LINT_ROOTS FLOW_FACT_LINT_BASELINE_PATH;
#   子命令 flow-manifest / flow-route-debts / flow-doc-budget / flow-trace / flow-fact-lint 按名调用(PATH)。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

MODE=close
case "${1:-}" in --between) MODE=between; shift ;; --wrap) MODE=wrap; shift ;; --ship) MODE=ship; shift ;; esac

# —— --ship:提交之后的五步。commit 必须已存在(判据在前,动作在后)——
if [ "$MODE" = ship ]; then
  COMMIT="${1:-}"; [ -n "$COMMIT" ] || flow_die "用法: flow-close --ship <commit> --subject <PR 标题> [--verdicts <三态表绝对>] [--dir <流程目录绝对>]"
  shift; SUBJ=""; VERD=""; SDIR=""
  while [ $# -gt 0 ]; do
    case "$1" in --subject|--verdicts|--dir) [ $# -ge 2 ] || flow_die "$1 缺值" ;; esac
    case "$1" in --subject) SUBJ="$2"; shift 2 ;; --verdicts) VERD="$2"; shift 2 ;; --dir) SDIR="$2"; shift 2 ;; *) flow_die "未知参数 $1" ;; esac
  done
  [ -n "$SUBJ" ] || flow_die "--ship 必须给 --subject(PR 标题是判断,不由脚本编)"
  if [ -n "$SDIR" ]; then
    case "$SDIR" in /*) ;; *) flow_die "--dir 须绝对路径: $SDIR" ;; esac
    [ -d "$SDIR" ] || flow_die "--dir 流程目录不存在: $SDIR"
  fi
  cd "$FLOW_REPO_DIR" || exit 2
  git cat-file -e "$COMMIT^{commit}" 2>/dev/null || flow_die "commit 不存在: $COMMIT(先提交,提交归人 / 编排方)"
  sred=0; st=0
  shdr() { st=$((st+1)); echo "== $st. $1 =="; }
  shdr "flow-clear-map-debt"
  if [ -n "$VERD" ]; then flow-clear-map-debt --verdicts "$VERD" "$COMMIT"; rc=$?; else flow-clear-map-debt "$COMMIT"; rc=$?; fi
  echo "RC=$rc"; [ "$rc" = 0 ] || sred=1
  shdr "map-debt 队列落笔(git commit -- $FLOW_MAP_DEBT)"
  if [ "$rc" != 0 ]; then
    echo "  跳过:上一步 RC=$rc —— 不拿没清干净的队列落笔"
  elif ! git ls-files --error-unmatch -- "$FLOW_MAP_DEBT_PATH" >/dev/null 2>&1; then
    echo "  info 队列件不在本仓的跟踪集里($FLOW_MAP_DEBT_PATH)—— 没有可落的笔,跳过"
  elif git diff --quiet HEAD -- "$FLOW_MAP_DEBT_PATH"; then
    echo "  info 队列件与 HEAD 逐字节相同 —— 本次一条都没勾掉,无需落笔"
  else
    QC="$(flow_tmpdir)/flow-ship-commit.$$"
    git commit -q -m "flow-kit 收口:清 map-debt 队列($COMMIT)" -- "$FLOW_MAP_DEBT_PATH" > "$QC" 2>&1; qrc=$?
    cat "$QC"; rm -f "$QC"; echo "RC=$qrc"
    if [ "$qrc" = 0 ]; then echo "  队列落笔 $(git rev-parse --short HEAD)($COMMIT 未动;PR 里两条)"
    else echo "  RED:队列清空没进本批 PR"; sred=1; fi
  fi
  shdr "git push origin $FLOW_DEV_BRANCH"
  git push origin "$FLOW_DEV_BRANCH" 2>&1 | tail -3; prc=$?
  cur=$(git rev-parse --short "origin/$FLOW_DEV_BRANCH" 2>/dev/null || echo none); echo "origin/$FLOW_DEV_BRANCH=$cur"
  git merge-base --is-ancestor "$COMMIT" "origin/$FLOW_DEV_BRANCH" 2>/dev/null || { echo "  RED:push 后 origin/$FLOW_DEV_BRANCH 不含 $COMMIT"; sred=1; }
  if [ "$sred" != 0 ]; then echo "SHIP RED: 未开 PR"; exit 1; fi
  shdr "gh pr create --base $FLOW_MAIN_BRANCH --head $FLOW_DEV_BRANCH"
  N=$(gh pr list --head "$FLOW_DEV_BRANCH" --base "$FLOW_MAIN_BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null)
  if [ -n "$N" ]; then echo "  已有开着的 PR #$N,复用"
  else
    gh pr create --base "$FLOW_MAIN_BRANCH" --head "$FLOW_DEV_BRANCH" --title "$SUBJ" --body "flow-kit 收口 · commit $COMMIT · $(date +%F)" > "$(flow_tmpdir)/flow-ship.$$" 2>&1; crc=$?
    tail -2 "$(flow_tmpdir)/flow-ship.$$"; rm -f "$(flow_tmpdir)/flow-ship.$$"
    [ "$crc" = 0 ] || { echo "SHIP RED: gh pr create RC=$crc"; exit 1; }
    N=$(gh pr list --head "$FLOW_DEV_BRANCH" --base "$FLOW_MAIN_BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null)
    [ -n "$N" ] || { echo "SHIP RED: 开了 PR 却取不到号"; exit 1; }
  fi
  shdr "flow-pr-merge $N --background"
  flow-pr-merge "$N" --background --subject "$SUBJ"; rc=$?; [ "$rc" = 0 ] || { echo "SHIP RED: flow-pr-merge RC=$rc"; exit 1; }
  if [ -n "$SDIR" ]; then
    shdr "flow-usage --write(窗延到收口末:commit / push / PR 进账;账不是门,不判红)"
    flow-usage "$SDIR" --write > "$(flow_tmpdir)/flow-ship-usage.$$" 2>&1; urc=$?
    LC_ALL=C grep -E '^USAGE|^FATAL|^WARN 编排方|^中断' "$(flow_tmpdir)/flow-ship-usage.$$" | head -8; rm -f "$(flow_tmpdir)/flow-ship-usage.$$"; echo "RC=$urc"
  fi
  echo "SHIP OK: PR #$N 已开,CI 绿即合(日志 $FLOW_FLOW_DIR_PATH/.pr-merge-$N.log;末行 PR-MERGE DONE|BLOCKED)"
  exit 0
fi

if [ "$MODE" = between ]; then
  [ $# -ge 4 ] || flow_die "用法: flow-close --between <流程目录> <基线> <申报清单> <after-hashes> [--task <任务号>] [--plan <plan绝对>]"
else
  [ $# -ge 3 ] || flow_die "用法: flow-close [--wrap] <流程目录(绝对)> <基线文件(绝对)> <申报清单(绝对)> [after-hashes(绝对)] [--task] [--plan] [--verdicts]"
fi
DIR="$1"; BASE="$2"; DECL="$3"; shift 3
AFTER=""
case "${1:-}" in ""|--*) ;; *) AFTER="$1"; shift ;; esac
TASK=""; PLAN=""; VERD=""; FACE=""
while [ $# -gt 0 ]; do
  case "$1" in --task|--plan|--verdicts|--face) [ $# -ge 2 ] || flow_die "$1 缺值" ;; esac
  case "$1" in
    --task) TASK="$2"; shift 2 ;;
    --plan) PLAN="$2"; shift 2 ;;
    --verdicts) [ "$MODE" = wrap ] || flow_die "--verdicts 只在 --wrap 下认"; VERD="$2"; shift 2 ;;
    --face) [ "$MODE" = between ] || flow_die "--face 只在 --between 下认(收口的申报清单是编排方的,没有面)"; FACE="$2"; shift 2 ;;
    *) flow_die "未知参数 $1" ;;
  esac
done
for p in "$DIR" "$BASE" "$DECL" ${AFTER:+"$AFTER"} ${PLAN:+"$PLAN"} ${VERD:+"$VERD"} ${FACE:+"$FACE"}; do
  case "$p" in /*) ;; *) flow_die "文件参数须绝对路径: $p" ;; esac
done
[ -z "$FACE" ] || [ -f "$FACE" ] || flow_die "写权限面清单不存在: $FACE"
[ "$MODE" = between ] && [ -z "$AFTER" ] && flow_die "--between 必须给 after-hashes(轮间核对的第一判据就是上一轮交付态)"

TMP=$(mktemp -d "$(flow_tmpdir)/flow-close.XXXXXX") || exit 2
trap 'rm -rf "$TMP"' EXIT
red=0
cd "$FLOW_REPO_DIR" || exit 2
step=0
hdr() { step=$((step+1)); echo "== $step. $1 =="; }

# 申报清单 → 纯路径集(剥哈希前缀 / git 状态位 / rename 箭头 / 行尾注释)
declp=$(sed -e 's/^[0-9a-f]\{40,\}  //' -e 's/^git \(..\) //' -e 's/^git //' "$DECL" | sed 's/.* -> //' | sed 's/^[[:space:]]*//' | grep -v '^#' | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//' | grep . | sort -u)

step_after() {
  [ -n "$AFTER" ] || return 0
  hdr "交付态哈希 sha256 -c $(basename "$AFTER")"
  flow_sha256_check "$AFTER" > "$TMP/after" 2>/dev/null
  ok=$(grep -c ': OK$' "$TMP/after"); bad=$(grep -vc ': OK$' "$TMP/after")
  echo "OK=$ok FAILED=$bad"
  [ $((ok+bad)) -gt 0 ] || { echo "  ⚠ 零条结果(清单为空或校验工具没跑起来)—— 空集不算绿(§J0)"; red=1; }
  [ "$bad" = 0 ] || { grep -v ': OK$' "$TMP/after"; echo "  (FAILED 若全在编排方并行编辑面则不算红 —— 由编排方自判,本脚本按红报)"; red=1; }
}

step_manifest() {
  hdr "flow-manifest verify"
  # 同层捕获:命令一次跑进文件,RC 紧跟其后;判读只读那个文件
  flow-manifest verify "$BASE" "$DECL" > "$TMP/verify" 2>&1; rc=$?
  grep -E 'RED|OK|FATAL|WARN' "$TMP/verify"; echo "RC=$rc"
  grep -qE 'verify OK' "$TMP/verify" || red=1
}

step_hollow() {
  hdr "非空转(抽掉一条确在实改集里的申报行,应 RED 且点名它)"
  victim=""
  changed=$(flow_changed_paths) || { echo "  ⚠ 实改集枚举失败(flow_changed_paths RC≠0)—— 非空转无对象可抽"; red=1; changed=""; }
  for p in $changed; do printf '%s\n' "$declp" | grep -qxF -- "$p" && { victim="$p"; break; }; done
  if [ -z "$victim" ]; then
    # 扫描区与 flow-manifest verify 同源:优先基线头行 areas:,旧格式基线才回退到路径首段
    areas=$(sed -n '1s/^# freeze-baseline .* areas: //p' "$BASE")
    [ -n "$areas" ] || areas=$(sed -n 's|^sha [0-9a-f]*  ||p' "$BASE" | cut -d/ -f1 | sort -u)
    sed -n 's/^sha //p' "$BASE" | sort > "$TMP/base-sha"
    for a in $areas; do [ -d "$a" ] && find "$a" -type f | while IFS= read -r f; do flow_sha256 "$f"; done; done | sort > "$TMP/cur-sha"
    for p in $(comm -13 "$TMP/base-sha" "$TMP/cur-sha" | sed 's/^[0-9a-f]*  //'); do printf '%s\n' "$declp" | grep -qxF -- "$p" && { victim="$p"; break; }; done
  fi
  if [ -z "$victim" ]; then
    echo "  实改集为空(或与申报零交集),非空转无对象 —— 不判红,但此时 verify OK 只证明「没改」,不证明探测器活着"
  else
    printf '%s\n' "$declp" | grep -vxF -- "$victim" > "$TMP/decl-minus"
    flow-manifest verify "$BASE" "$TMP/decl-minus" > "$TMP/verify2" 2>&1; rc2=$?
    grep -E 'RED|OK|FATAL' "$TMP/verify2"; echo "RC=$rc2(抽掉 $victim)"
    if [ "$rc2" = 1 ] && grep -qF "RED 漏申报: $victim" "$TMP/verify2"; then
      :
    else
      echo "  ⚠ 非空转失败:抽掉实改集里的一行后没有点名它的 RED —— verify 本身不可信"; red=1
    fi
  fi
}

# 0.9.0:假话门由编排方在活树跑,轮收工 / 收口都跑。此前它只在 flow-round open(F-13)与 agent 自己的收工命令里跑 ——
#   判据在 agent 自陈里,编排方从没独立跑过;P3-4 ②B-F 的微改 patch 带进一行 RED NEW QUANT,到下一轮 open 才炸。
#   一个判据只在一处由不写代码的一方跑;agent 自跑的那次是给它自己的提示,不是判据。
step_factlint() {
  hdr "flow-fact-lint verify(假话门,编排方独立跑)"
  if [ -z "$FLOW_FACT_LINT_ROOTS" ]; then echo "  跳过:FLOW_FACT_LINT_ROOTS 未配置"; return 0; fi
  if [ ! -f "$FLOW_FACT_LINT_BASELINE_PATH" ]; then echo "  跳过:基线不存在 $FLOW_FACT_LINT_BASELINE_PATH(先 flow-fact-lint baseline)"; return 0; fi
  flow-fact-lint verify > "$TMP/factlint" 2>&1; frc=$?
  LC_ALL=C grep -E '^verify|^RED|^FATAL' "$TMP/factlint"; echo "RC=$frc"
  [ "$frc" = 0 ] || red=1
}

# 0.9.0 越面:申报 ⊆ 写权限面(.face-<轮名>.txt,flow-dispatch 从触面落的;与 flow-micro 同一套面内判法)。
#   病根:.face 落了三个版本,唯一的消费者是 flow-micro;轮收工没有任何工具比过「实改集在不在面内」——
#   P3-4 三轮的申报清单都含 apps/web/test/ 与 packages/core/src/index.ts,面里没有,没人量。例外只走申报行尾 `# 裁决-N`(与测试锁同一条通道)。
step_face() {
  [ -n "$FACE" ] || { echo "== (越面跳过:未给 --face;flow-dispatch --dir 才落 .face-<轮名>.txt)=="; return 0; }
  hdr "越面(申报 ⊆ $(basename "$FACE");例外走申报行尾 # 裁决-N)"
  declv=$(grep -v '^[[:space:]]*#' "$DECL" | LC_ALL=C grep -E '#[^#]*裁决[- ]*[0-9]+' | sed -e 's/^[0-9a-f]\{40,\}  //' -e 's/^git \(..\) //' -e 's/^git //' | sed 's/.* -> //' | sed 's/^[[:space:]]*//' | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//' | grep . | sort -u)
  nin=0; nout=0
  for p in $declp; do
    inf=0
    while IFS= read -r e; do
      case "$e" in ''|\#*) continue ;; esac
      e=${e%/}
      [ "$p" = "$e" ] && { inf=1; break; }
      case "$p" in "$e"/*) inf=1; break ;; esac
    done < "$FACE"
    if [ "$inf" = 1 ]; then nin=$((nin+1))
    elif printf '%s\n' "$declv" | grep -qxF -- "$p"; then echo "ok   面外但申报行带裁决号: $p"; nin=$((nin+1))
    else echo "RED 越面: $p 不在写权限面内,申报行也无裁决号 —— 还原它,或编排方以裁决扩面:申报行写成「$p  # 裁决-N <为什么>」"; nout=$((nout+1)); fi
  done
  echo "面内 $nin · 越面 $nout(面 $(grep -cv '^[[:space:]]*#' "$FACE" || true) 条)"
  [ "$nout" = 0 ] || red=1
}

step_tree() {
  hdr "树读数(HEAD + porcelain;读数不判红,交接口的对账靠它)"
  echo "HEAD=$(git -C "$FLOW_REPO_DIR" rev-parse --short HEAD)"
  git -C "$FLOW_REPO_DIR" -c core.quotepath=false status --porcelain -uall > "$TMP/porc"; prc=$?
  echo "porcelain=$(LC_ALL=C grep -c . "$TMP/porc") RC=$prc"
  [ "$prc" = 0 ] || { echo "  ⚠ porcelain 枚举失败 —— 空集不算绿"; red=1; }
}

step_route() {
  [ -n "$TASK" ] || { echo "== (路由复跑跳过:未给 --task)=="; return 0; }
  hdr "路由复跑(按申报清单的实改路径;diff 派单必读,漏路由当场红)"
  # 多行路径不进 -v / 不靠 zsh 分词:逐行读进位置参数
  set --
  for p in $declp; do set -- "$@" "$p"; done
  flow-route-debts "$TASK" "$@" > "$TMP/route" 2>&1; rrc=$?
  cat "$TMP/route"; echo "RC=$rrc 条数=$(grep -c '^- ' "$TMP/route" || true)"
  [ "$rrc" = 0 ] || red=1
}

step_trace() {
  { [ -n "$TASK" ] && [ -n "$PLAN" ]; } || { echo "== (REQ 对账跳过:需 --task 与 --plan)=="; return 0; }
  hdr "flow-trace REQ ↔ 测试对账"
  flow-trace "$PLAN" "$TASK" > "$TMP/trace" 2>&1; trc=$?
  tail -1 "$TMP/trace"; echo "RC=$trc"
  # RC=3 = TRACE N/A(本仓 plan 不写 REQ 行,对账不适用)—— 印 info 不判红。
  # 不适用与不达标不是一件事:ShipLedger P3-1 批 6 次 close 都被这条判成红,靠人眼记住「这条是假的」(protocol §5 不许)。
  if [ "$trc" = 3 ]; then echo "info REQ 对账不适用(TRACE N/A)—— 不判红;本任务的接收位覆盖由 flow-receipts 管"; return 0; fi
  [ "$trc" = 0 ] || red=1
}

step_lint() {
  hdr "flow-route-debts --lint"
  flow-route-debts --lint; rc4=$?; [ "$rc4" = 0 ] || red=1
}

step_budget() {
  hdr "flow-doc-budget"
  flow-doc-budget "$DIR" > "$TMP/budget" 2>&1; rc5=$?
  grep -E '^RED|^FATAL|^WARN|^——|^info' "$TMP/budget"; echo "RC=$rc5"
  [ "$rc5" = 0 ] || red=1
}

step_rulebook() {
  hdr "规则书棘轮 $FLOW_LOCAL_DOC(字节只许降;行数上限 $FLOW_DOC_BUDGET_RULEBOOK)"
  if [ -f "$FLOW_LOCAL_DOC_PATH" ]; then
    cur=$(wc -c < "$FLOW_LOCAL_DOC_PATH" | tr -d ' ')
    curl=$(wc -l < "$FLOW_LOCAL_DOC_PATH" | tr -d ' ')
    rb="$FLOW_FLOW_DIR_PATH/.rulebook-bytes"
    rl="$FLOW_FLOW_DIR_PATH/.rulebook-lines"
    if [ ! -f "$rb" ] && [ -f "$rl" ]; then
      stored=$(tr -d ' \n' < "$rl")
      case "$stored" in ''|*[!0-9]*) flow_die "棘轮记录不是数字,拒绝比对: $rl 内容「$stored」" ;; esac
      if [ "$curl" -gt "$stored" ]; then
        echo "RED 规则书变长(旧单位 行): $stored → $curl —— 换单位不洗欠账,先退役再换"; red=1
      else
        mkdir -p "$FLOW_FLOW_DIR_PATH"; printf '%s\n' "$cur" > "$rb"; rm -f "$rl"
        echo "OK 规则书棘轮换单位(0.8.3 行 → 字节):旧读数 $stored → $curl 行(未变长);新基线 $cur 字节 → $rb"
      fi
    elif [ -f "$rb" ]; then
      stored=$(tr -d ' \n' < "$rb")
      case "$stored" in ''|*[!0-9]*) flow_die "棘轮记录不是数字,拒绝比对: $rb 内容「$stored」" ;; esac
      if [ "$cur" -gt "$stored" ]; then
        echo "RED 规则书变长: $stored → $cur 字节(棘轮只许降;退役子句 flow-rulebook retire N.k 后重跑)"; red=1
      else
        printf '%s\n' "$cur" > "$rb"; echo "OK 规则书棘轮: $stored → $cur 字节($curl 行)"
      fi
    else
      mkdir -p "$FLOW_FLOW_DIR_PATH"; printf '%s\n' "$cur" > "$rb"
      echo "OK 规则书棘轮首次记账: $cur 字节($curl 行)→ $rb"
    fi
    if [ "$curl" -gt "$FLOW_DOC_BUDGET_RULEBOOK" ]; then
      echo "RED 规则书 $curl 行 > 上限 $FLOW_DOC_BUDGET_RULEBOOK:$FLOW_LOCAL_DOC_PATH"; red=1
    fi
  else
    echo "  规则书不存在,跳过: $FLOW_LOCAL_DOC_PATH"
  fi
}

# —— 收口机械段(--wrap)——
step_verdicts() {
  [ -n "$VERD" ] || { echo "== (三态表 dry-run 跳过:未给 --verdicts)=="; return 0; }
  hdr "flow-ledger apply $(basename "$VERD")(dry-run;--write 归编排方 diff 审之后)"
  flow-ledger apply "$VERD" > "$TMP/verd" 2>&1; rc=$?
  LC_ALL=C grep -E 'dry-run|LEDGER|VERDICTS|RED|FATAL|WARN' "$TMP/verd" | head -40; echo "RC=$rc"; [ "$rc" = 0 ] || red=1
}
step_index() {
  hdr "flow-render-index --write"
  flow-render-index --write > "$TMP/idx" 2>&1; rc=$?; tail -2 "$TMP/idx"; echo "RC=$rc"; [ "$rc" = 0 ] || red=1
}
step_gates() {
  hdr "flow-gates --reset(收口那一次整跑;命中缓存就不整跑)"
  mkdir -p "$DIR/.evidence"
  ( cd "$FLOW_REPO_DIR" && flow-gates --reset > "$DIR/.evidence/close-gates.txt" 2>&1 ); rc=$?
  LC_ALL=C grep -E '^FLOW-GATES' "$DIR/.evidence/close-gates.txt" | tail -1; echo "RC=$rc(全量 $DIR/.evidence/close-gates.txt)"; [ "$rc" = 0 ] || red=1
  # 门读数一行(0.7.0):根文档那句「门读数」每批都是编排方 grep 三次 + cut -c 窥视拼出来的;这里从同源 rc.txt 直接拼好,照抄即可
  # 0.9.0:命中缓存时 $o 是**缓存条目**的证据目录,拼出来的读数是上一次整跑的 —— 行里必须带 cached@<那次的时间>,
  #   否则根文档那句门读数的出处就是 kit 自己丢的(与审轴「把上一轮读数报成自己的」同一件事)
  o=$(LC_ALL=C sed -n 's/.*FLOW-GATES [A-Z]* key=[0-9a-f]* out=\([^ ]*\).*/\1/p' "$DIR/.evidence/close-gates.txt" | tail -1)
  ctag=$(LC_ALL=C sed -n 's/^CACHED PASS(同树键 reset 口径 @\([^,]*\),.*/cached@\1;/p' "$DIR/.evidence/close-gates.txt" | tail -1)
  if [ -n "$o" ] && [ -f "$o/rc.txt" ]; then
    line=$(LC_ALL=C awk '/^infra-guard/{next} /^[A-Za-z0-9_]+ RC=/{cur=$1; next} /^[A-Za-z0-9_]+ skipped$/{cur=""; next}
      cur!="" && NF { gsub(/^[ \t]+|[ \t]+$/, ""); if (!(cur in seen)) {seen[cur]=1; order[++n]=cur; r[cur]=$0} else r[cur]=r[cur] " · " $0 }
      END{ for(i=1;i<=n;i++) printf "%s%s → %s", (i>1?";":""), order[i], r[order[i]]; printf "\n" }' "$o/rc.txt")
    [ -n "$line" ] && echo "门读数(照抄进根文档;${ctag}同源 $o/rc.txt):$line"
  fi
}
step_markdone() {
  { [ -n "$TASK" ] && [ -n "$PLAN" ]; } || { echo "== (REQ 翻 done 跳过:需 --task 与 --plan)=="; return 0; }
  hdr "flow-trace --mark-done(open 且有测试的 REQ 翻 [done];逐条印行号,不该翻的手工改回;plan 须在申报清单里)"
  flow-trace "$PLAN" "$TASK" --mark-done > "$TMP/md" 2>&1; rc=$?
  LC_ALL=C grep -E '^mark-done|^WARN|^TRACE' "$TMP/md"; echo "RC=$rc"
  if [ "$rc" = 3 ]; then echo "info 无 REQ 可翻(TRACE N/A)—— 不判红;本仓 plan 的状态不由 REQ 行记"; return 0; fi
  [ "$rc" = 0 ] || red=1
}
step_usage() {
  hdr "flow-usage --write(轮数账;零会话命中只 WARN,账不是门)"
  flow-usage "$DIR" --write > "$TMP/usage" 2>&1; rc=$?
  LC_ALL=C grep -E '^USAGE|^FATAL|^WARN' "$TMP/usage" | head -20; echo "RC=$rc"
  [ "$rc" = 0 ] || echo "  WARN:轮数账没生成(transcripts 没扫到本批)—— 不判红"
}
step_state() {
  hdr "状态档事实段"
  flow-round state "$DIR" | tail -1
}

if [ "$MODE" = between ]; then
  step_after; step_manifest; step_hollow; step_factlint; step_face; step_tree; step_route; step_trace; step_budget
  if [ "$red" = 0 ]; then echo "BETWEEN OK"; exit 0; else echo "BETWEEN RED"; exit 1; fi
fi
if [ "$MODE" = wrap ]; then
  # —— 0.8.2 调步序:先核交付态,再让 kit 自己动树 ——
  # 这一段里有两个写手:step_index(`flow-render-index --write` 改索引文档)与 step_markdone(`flow-trace --mark-done` 改 plan)。
  # 它们原本排在 step_after / step_manifest / step_hollow **之前**,而 plan 与索引文档都在编排方的申报清单里
  # ⟹ 交付态哈希核的是 kit 刚改过的树,`--plan` 一旦真翻了 REQ 状态,after 那条必红。
  # ShipLedger P3-3 没炸,只因为它的 plan 零 REQ 行(TRACE N/A ⟹ 零翻转);换到写 REQ 行的仓,收口第一次就红在最贵的时刻。
  # 头注原先只想到「plan 要在申报清单里,否则 verify 报漏申报」,漏了「在清单里也会因为被改而红」这半边。
  # 两个写手另外都挪到 red=0 之后:树已经红了就别再往里写,修完重跑即可(两者都幂等)。
  step_after; step_manifest; step_hollow; step_factlint
  step_verdicts; step_lint; step_trace
  if [ "$red" = 0 ]; then step_index; step_markdone; else echo "== (索引重渲 与 REQ 翻 done 跳过:前面已红,先修完再让 kit 动树)=="; fi
  step_gates; step_budget; step_rulebook; step_usage; step_state
  if [ "$red" = 0 ]; then
    cat <<WOK
WRAP OK: 机械段全绿。剩下的归编排方(判断步,照这个顺序;不必再读 close-block.md):
  1. 账本:flow-ledger apply <三态表> --write · append <标记> "<一行>" · add --owner … --due … --touches … --title … --body-file <正文文件>
     (已还条目的开口项单开新条;owner 不锚已收工任务;新条落接收位,flow-receipts 能扫到)
  2. spec:任务节写「落地记录 <日期> · 收口」+ 下一刀的接收位;REQ 状态已由 --mark-done 翻好,不再手改
  3. 根文档:只改门读数与批次标签 —— 上面「门读数(照抄进根文档…)」那一行照抄
  4. 规则书:flow-rulebook retire <行号> --section "<§X · 批次>" --reason "<一句>"(每批 ≥ 1 条;先 flow-rulebook show 看行号)
  5. git commit(消息 = 〇 正面结论 + 裁决号段 + 门 + 账;单独一条命令,前面不串别的)
  6. flow-close --ship <commit> --subject "<PR 标题>" [--verdicts <三态表>] --dir $DIR(末尾重跑轮数账,窗含收口)
  7. memory(号段 / 门 / 进度 / 下一批从 N 起);轮数账手填段只剩「本批退役规矩数」
WOK
    exit 0
  else echo "WRAP RED"; exit 1; fi
fi
step_manifest; step_hollow; step_after; step_factlint; step_lint; step_budget; step_rulebook
if [ "$red" = 0 ]; then echo "ROUND-CLOSE OK"; exit 0; else echo "ROUND-CLOSE RED"; exit 1; fi
