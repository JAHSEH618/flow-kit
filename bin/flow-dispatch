#!/bin/sh
# flow-dispatch —— 派单必带块装配器。
# 病根:派单里引的命令、引的数、引的模式与实跑不同源,全是编排方手工装配时抄错 —— 每次修法都是再加一条给人记的散文。
#   本脚本把「欠账必读段 = 紧邻命令的实跑输出」做成结构性事实:输出块里的命令行与其下的输出出自同一次执行,想抄错都没有入口。
# 两条机械上限(两轴分开,别混算):
#   · owner 归本任务的欠账 > FLOW_DEBT_CAP ⟹ RC=3(还账义务过载 —— 拆任务/专开还账批次,或 --cap-ok <理由> 显式带过,理由进派单;过大 CL 的处置同理:拆)。
#   · 必读总条数 > FLOW_DEBT_WARN ⟹ 只 WARN(触面宽前缀的欠账天然到处命中,那是账本刻意的;总数按门设会让 --cap-ok 变成仪式)。
#
# 用法:
#   flow-dispatch <任务号> --tree <快照|活树-独占|禁入> --db <独占|只读|禁用> --seq <N> [--round <①写|②A|②B|③改|④A|④B>] \
#       [--dir <流程目录绝对路径>] [--core <core写权限面>] [--plan <plan文件绝对路径>] [--cap-ok <理由>] <触面路径(仓库相对)...>
#   flow-dispatch --resume <原派单件绝对路径> --dir <流程目录> [--round <原轮名>]  # 续轮派单:从步骤账机械生成(0.6.0)
#     轮名默认从原派单的「轮次 / 模型」行取(0.8.2);--round 给了必须与它一致,且**不许带 `-续`** —— 续轮不是新轮,
#     它沿用原轮的基线 / 步骤账 / 申报清单,轮名只有一个。原派单件本身是续轮派单 ⟹ FATAL(续轮不接续轮,仍指最初那份)。
#   --dir 给了才能:① 把冻结 / 收工 / 门 / 预算的命令**连实参**印进块(agent 不必学用法,编排方不必读 kit 源码);
#              ② 建步骤账 .steps-<轮名>.md(①写按 open REQ 一条一步;其余轮 装载 / 主活 / 回件 / 收工核对),agent 每步 flow-step done;
#              ③ 建 .evidence/。与 flow-round open|close 同一套约定文件名。--dir 必须与 --round 同给。
#   任务节选按轴(0.6.0):①写(或未给 --round)印正文但按 FLOW_DISPATCH_EXCERPT_BYTES 封顶 —— 超过只印 节头 + outline + REQ 行 + 节尾
#     (本刀的落位段住在节尾),中间给「文件 + 行号」指针;②③④ 一律只印 outline + REQ 行(它们读的是回件索引表,不是任务书正文)。
#     实测一节 42 KB 横跨三刀,八个 agent 各读一遍 ≈ 该批携带的 10%。REQ 行只印 open / deferred(0.7.0):[done] 行 p4e 实测占派单 10.3 KB。
#   收工段的 flow-gates --reset 只印给 --db 独占 的轮(F-22);②③④ 的欠账必读**不**按申报清单路由 —— 实测过,账本触面是宽前缀,28 = 28 条,零收益。
#   --round 只决定「轮次 / 模型」行:FLOW_ROLE_MODELS 里给了该轮就印 model=<x>(Agent 调用照抄),否则继承编排方。
#   带 --plan 时另数任务节的 REQ:open > FLOW_REQ_CAP ⟹ RC=3(①写是最长的会话,携带成本随轮数平方长;拆任务,或 --cap-ok 带过,理由进派单)。
#   flow-dispatch <任务号> --tree … --db … --seq … --lane-merge <路径清单文件(绝对)> [触面路径...]
#       合并批模式:触面从清单文件读(一行一路径;# 注释与空行略过);命令行再给的触面必须都在清单里,否则 FATAL;拒绝 --plan。
# 输出:整块 markdown 到 stdout,重定向成 <流程目录>/<轮号>-dispatch.md 就是派单;「(待填)」标记的行由编排方 Edit 补,其余勿手改 —— 要改就重跑。
#   生成段由 `<!-- flow:gen-begin -->` / `<!-- flow:gen-end -->` 括起(止标记落在「编排方待填」之前):flow-doc-budget 按总字节减去它判自写预算。
#   派单件 48 KB 里 46 KB 是这里生成的,一个字节也不用模型打 —— 从前它每批都要一句 `budget-ok:` 带过,那是同一条线同时判两种东西。
#   Agent prompt 只给这个文件的路径(编排方零 heredoc:它的输出按输出价计,一批里占它携带上下文的 33%)。
#   带 --plan 时同源摘取任务节(`## <任务号> ` 到下一个 `## `,与 flow-receipts 同一套定位)印进块里:agent 只读节选,不整读 plan(一份 135 KB 的 plan 被读了 56 次)。
# 读的配置:FLOW_KIT_DIR(回件模板绝对路径,自算)FLOW_REPO_DIR FLOW_DEBT_CAP FLOW_DEBT_WARN FLOW_REQ_CAP FLOW_ROLE_MODELS FLOW_FIX_BY_WRITER FLOW_DOC_BUDGET_FILE FLOW_DOC_BUDGET_SELF FLOW_SPEC_DIRS FLOW_WS/FLOW_FACT_LINT_BASELINE;
#   子命令 flow-route-debts / flow-receipts 按名调用(PATH),输出原样嵌入。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

# —— 续轮派单:不重建推理,从步骤账的下一个未勾步骤接手;没有步骤账就没有断点(FATAL) ——
if [ "${1:-}" = "--resume" ]; then
  ORIG="${2:-}"; shift 2 2>/dev/null || flow_die "--resume 缺原派单件路径"
  RDIR=""; RROUND=""
  while [ $# -gt 0 ]; do
    case "$1" in --dir|--round) [ $# -ge 2 ] || flow_die "$1 缺值" ;; esac
    case "$1" in --dir) RDIR="$2"; shift 2 ;; --round) RROUND="$2"; shift 2 ;; *) flow_die "--resume 只认 --dir 与 --round,得到 $1" ;; esac
  done
  case "$ORIG" in /*) ;; *) flow_die "原派单件须绝对路径: $ORIG" ;; esac
  [ -f "$ORIG" ] || flow_die "原派单件不存在: $ORIG"
  [ -n "$RDIR" ] || flow_die "--resume 必须给 --dir"
  case "$RDIR" in /*) ;; *) flow_die "--dir 须绝对路径: $RDIR" ;; esac
  # —— 0.8.2:轮名从**原派单里**取,不由 --round 说了算(契约 3 两侧同源)——
  # 病根:编排方把上一次生成的续轮名(`①写-续`)又喂回 --round,下面那行无条件再拼一层 ⟹ `①写-续-续`。
  #   回件首行照它写,flow-round 认领不到,状态档那两格退回 ⚠glob猜;门读数还顺着 `①写-*gates*` 串进了 ①写 行(F-2 同一次实测)。
  #   续轮**不是新轮**:它沿用原轮的基线 / 步骤账 / 申报清单 / 交付态哈希,所以轮名只能有一个,就是原派单里那个。
  if LC_ALL=C grep -q -- '派单必带块 —— .*-续(' "$ORIG"; then
    flow_die "原派单件本身就是一份续轮派单($ORIG)—— 续轮不接续轮:同一轮再中断一次,仍拿**最初那份**派单跑 --resume(进度记在步骤账里,已勾的步骤不会重做)"
  fi
  ORIGROUND=$(LC_ALL=C sed -n 's/^- \*\*轮次 \/ 模型\*\*:\([^ ]*\).*/\1/p' "$ORIG" | head -1)
  case "$RROUND" in
    *-续) flow_die "--round 不许带 -续(得到「$RROUND」)—— 续轮不是新轮,给**原轮名**即可,`-续` 由本命令拼。轮名翻倍会让 flow-round 认不出回件与门读数" ;;
  esac
  if [ -n "$RROUND" ] && [ -n "$ORIGROUND" ] && [ "$RROUND" != "$ORIGROUND" ]; then
    flow_die "--round「$RROUND」与原派单的「轮次 / 模型」行「$ORIGROUND」对不上($ORIG)—— 两侧同源:要么改 --round,要么换原派单件"
  fi
  [ -n "$RROUND" ] || RROUND="$ORIGROUND"
  [ -n "$RROUND" ] || flow_die "原派单里没有「轮次 / 模型」行,取不到轮名($ORIG)—— 显式给 --round <原轮名>(不带 -续)"
  STEPS="$RDIR/.steps-$RROUND.md"
  [ -f "$STEPS" ] || flow_die "步骤账不存在: $STEPS —— 没有步骤账就没有断点;先从回件重建(flow-step init $RDIR $RROUND <步骤…>,已做的 flow-step done)再来"
  LAST=$(flow-step show "$RDIR" "$RROUND" | tail -1)
  case "$LAST" in "STEPS DONE"*) flow_die "步骤账已全勾($LAST)—— 不是断点,是收工;走 flow-round close" ;; esac
  # 0.9.0:快照轮的续轮不核 verify(副本里 FATAL),核上一轮交付态的 shasum -c
  RTREE=$(LC_ALL=C sed -n 's/^- \*\*树权限\*\*:\([^(]*\).*/\1/p' "$ORIG" | head -1)
  case "$RTREE" in
    快照*) RPREV=$(ls -t "$RDIR"/.after-*-hashes.txt 2>/dev/null | grep -v "/.after-$RROUND-hashes.txt\$" | head -1); [ -n "$RPREV" ] || RPREV="<上一轮 .after-*-hashes.txt>"
           if command -v shasum >/dev/null 2>&1; then RCHK="shasum -a 256 -c"; else RCHK="sha256sum -c"; fi
           RCORE="\`$RCHK $RPREV | grep -vc ': OK\$'\`(应为 0:快照没被动;别跑 flow-manifest verify,副本里它 FATAL)" ;;
    *)     RCORE="\`flow-manifest verify $RDIR/.manifest-baseline-$RROUND.txt $RDIR/.declared-$RROUND.txt\`(申报清单还没落就先按回件索引表 / \`git status\` 补一份)" ;;
  esac
  # ⚠ 下面是未加引号的 heredoc:反引号要写成 \` 才是字面量。0.6.0 写成 \\\` 留下了活反引号,把 flow-manifest verify / git status / ls 真跑了一遍、
  #   输出嵌进派单,<N> 还被当成重定向(「N: No such file」)—— F-24,p4e 实测。
  cat <<RS
<!-- flow:gen-begin -->
## 派单必带块 —— $RROUND-续(flow-dispatch --resume 生成 $(date +%F);原派单 $ORIG;生成段勿手改,要改重跑)

- **你是谁**:$RROUND-续。上一个 $RROUND agent 已停(叫停 / 限额 / watchdog),上下文唤不回;你**不重建推理**,从步骤账的下一个未勾步骤接手,不开新战场。
- **原派单**(整块照做;已勾的步骤跳过,权限面 / 号段 / 纪律全部沿用):$ORIG
- **步骤账**:$STEPS —— $LAST
  每完成一步:\`flow-step done $RDIR $RROUND <N> "<一句>"\`;续轮之外别的 agent 也可能接手,勾在文件里不在你脑子里
- **先对树核,再动手**(通知里的 result 只带首句;watchdog 判 failed 也不代表没干活 —— 两批实测两次中断都停在「差最后一步」):
  $RCORE
  \`ls -t $RDIR/.evidence | head\` 看最后一条落盘;回件已有的节**只追加不重写**,
  **唯一例外是〇节**:它若还是 \`(待收工填)\` 之类的占位,就**在原位补全**,别把结论补在末尾另起一节。
  〇 是下游整轮唯一的跳读入口 —— 占位留着,下一轮只能整读你这份件(实测 ④A 的〇节 52 字节占位 ⟹ ③改二 整读 33 KB)
- **收工件**:同原派单(.after-$RROUND-hashes.txt · .declared-$RROUND.txt · 回件);回件末尾加一行「续轮从步骤 N 接手,N 之前的内容出自上一个 agent」
<!-- flow:gen-end -->

### 编排方待填(生成器管不到的判断项)
- 上一个 agent 停在哪(树上实际状态,编排方独立读数,非 agent 自陈;半截变异态还是已复原)
- 已知未闭的编译错 / 门读数(零门读数就写「零门读数,别拿任何数当交付」)
RS
  echo "" ; echo "步骤账全文:"; cat "$STEPS"
  exit 0
fi

TASK="${1:-}"; [ -n "$TASK" ] || flow_die "缺任务号"
shift
TREE=""; DB=""; SEQ=""; CORE="(待填:两档之一 —— 「只许改 shell,核心库一个字节不许动」或「核心库限 <文件/性质>」,protocol §1)"
PLAN=""; CAPOK=""; LANE=""; ROUND=""; DIR=""
while [ $# -gt 0 ]; do
  case "$1" in --tree|--db|--seq|--core|--plan|--cap-ok|--lane-merge|--round|--dir) [ $# -ge 2 ] || flow_die "$1 缺值" ;; esac
  case "$1" in
    --round) ROUND="$2"; shift 2 ;;
    --dir) DIR="$2"; shift 2 ;;
    --tree) TREE="$2"; shift 2 ;;
    --db)   DB="$2";   shift 2 ;;
    --seq)  SEQ="$2";  shift 2 ;;
    --core) CORE="$2"; shift 2 ;;
    --plan) PLAN="$2"; shift 2 ;;
    --cap-ok) CAPOK="$2"; shift 2 ;;
    --lane-merge) LANE="$2"; shift 2 ;;
    --*) flow_die "未知参数 $1" ;;
    *) break ;;
  esac
done
if [ -n "$LANE" ]; then
  [ -z "$PLAN" ] || flow_die "--lane-merge 与 --plan 互斥:合并批不带功能触面,没有接收位可覆盖"
  case "$LANE" in /*) ;; *) flow_die "--lane-merge 须绝对路径(文件参数一律绝对路径): $LANE" ;; esac
  [ -f "$LANE" ] || flow_die "--lane-merge 清单不存在: $LANE"
else
  [ $# -ge 1 ] || flow_die "缺触面路径(仓库相对)"
fi
case "$TREE" in 快照*|活树-独占|禁入) ;; *) flow_die "--tree 须为 快照|活树-独占|禁入(protocol §3),得到:「$TREE」" ;; esac
case "$DB" in 独占|只读|禁用) ;; *) flow_die "--db 须为 独占|只读|禁用(protocol §3),得到:「$DB」" ;; esac
[ -n "$SEQ" ] || flow_die "缺 --seq 裁决起号(protocol §3)"
if [ -n "$PLAN" ]; then case "$PLAN" in /*) ;; *) flow_die "--plan 须绝对路径(文件参数一律绝对路径)" ;; esac; fi
if [ -n "$DIR" ]; then
  case "$DIR" in /*) ;; *) flow_die "--dir 须绝对路径: $DIR" ;; esac
  [ -d "$DIR" ] || flow_die "--dir 流程目录不存在: $DIR"
  [ -n "$ROUND" ] || flow_die "--dir 必须与 --round 同给(约定文件名按轮名派生)"
  mkdir -p "$DIR/.evidence"
fi

TMP=$(mktemp -d "$(flow_tmpdir)/flow-dispatch.XXXXXX") || exit 2
trap 'rm -rf "$TMP"' EXIT

# 合并批:触面 = 清单文件;命令行触面只许是清单的子集(合并批不带功能触面)
if [ -n "$LANE" ]; then
  sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$LANE" | grep . > "$TMP/lane"
  [ -s "$TMP/lane" ] || flow_die "--lane-merge 清单里零条路径(空集不是合并批): $LANE"
  for p in "$@"; do
    grep -qxF -- "$p" "$TMP/lane" || flow_die "触面 $p 不在合并批清单里(合并批只做支合并 + 跨检,不带功能触面): $LANE"
  done
  set --
  while IFS= read -r l; do set -- "$@" "$l"; done < "$TMP/lane"
fi

# 触面纪律:仓库相对,绝对路径当场 FATAL;含空白的单个实参 FATAL(守卫在库里,flow-route-debts 共用同一条);
#   不存在的路径只 WARN(计划中的新文件合法)
flow_check_ws_args 触面 "$@"
for p in "$@"; do
  case "$p" in
    /*) flow_die "触面参数必须仓库相对,不许绝对路径(绝对路径让路径轴整条静默失效): $p" ;;
  esac
  [ -e "$FLOW_REPO_DIR/$p" ] || flow_warn "触面在树里不存在(允许:计划中的新文件): $p"
done

# 写权限面清单 .face-<轮名>.txt(0.8.0):微改通道的「全在③写权限面内」这条门槛要有机器可读的面。
# 面 = 本轮触面路径,一行一条;flow-micro --face 按它判 patch 的每个路径(精确或目录前缀)。
# ⚠ 必须写在任何 `set --` 之前:后面建步骤账那段会把 "$@" 冲掉。
if [ -n "$DIR" ]; then
  { echo "# 写权限面 · $ROUND(flow-dispatch 生成 $(date +%F);= 派单里的触面路径,一行一条)"
    echo "# flow-micro --face 按它判微改 patch 的路径是否面内;编排方要扩面得以裁决显式扩,别在这里手加"
    for p in "$@"; do printf '%s\n' "$p"; done
  } > "$DIR/.face-$ROUND.txt"
fi

# 写权限面的散文行(0.9.0)也从同一组 "$@" 印:P3-4 的许写面是编排方手写的,与 .face 零互校,漏了 apps/web/test/ 三轮没人量。
#   许写 = 触面;禁写推不出来(模板明说别写「其余不许」),留在待填段。
FACE_TXT=""
for p in "$@"; do FACE_TXT="$FACE_TXT
    $p"; done

# 命令行的逐字重建先于一切会动 "$@" 的段(给复审按 review-template 逐字重跑;参数与执行同一数组,同源 by construction)
CMD="flow-route-debts $TASK"
for p in "$@"; do CMD="$CMD $p"; done
# 同层捕获(protocol §4 硬规矩 2:不隔管道取 RC)
flow-route-debts "$TASK" "$@" > "$TMP/debts" 2>&1; DRC=$?
NDEBT=$(grep -c '^- ' "$TMP/debts" || true)
NOWN=$(grep -c "owner $TASK " "$TMP/debts" || true)
if [ "$DRC" -ne 0 ]; then echo "FATAL: flow-route-debts RC=$DRC,输出:" >&2; cat "$TMP/debts" >&2; exit 2; fi

RRC=""; SECS=""; SECE=""
if [ -n "$PLAN" ]; then
  flow-receipts "$PLAN" "$TASK" > "$TMP/rcpt" 2>&1; RRC=$?
  # 任务节同源摘取:`## <任务号> ` 起到下一个 `## ` 前(与 flow-receipts 同一套定位);找不到只 WARN,接收位那段已带 RC
  SECS=$(grep -n "^## $TASK " "$PLAN" | head -1 | cut -d: -f1)
  [ -n "$SECS" ] || SECS=$(grep -n "^## $TASK" "$PLAN" | head -1 | cut -d: -f1)
  if [ -n "$SECS" ]; then
    SECE=$(awk -v s="$SECS" 'NR>s && /^## /{print NR-1; exit}' "$PLAN")
    [ -n "$SECE" ] || SECE=$(wc -l < "$PLAN" | tr -d ' ')
    sed -n "${SECS},${SECE}p" "$PLAN" > "$TMP/sec"
  fi
fi
# 任务节 REQ 计数(与 flow-trace 同一格式:同一行既有 REQ-ID 又有 [状态])
NOPEN=0; NDONE=0; NDEF=0
if [ -s "$TMP/sec" ]; then
  REQ_RE=$(flow_req_re)
  NOPEN=$(LC_ALL=C grep -cE "$REQ_RE.*\[open" "$TMP/sec")
  NDONE=$(LC_ALL=C grep -cE "$REQ_RE.*\[done" "$TMP/sec")
  NDEF=$(LC_ALL=C grep -cE "$REQ_RE.*\[deferred" "$TMP/sec")
fi
# 轮次 / 模型行:--round 给了才查 FLOW_ROLE_MODELS(空格分隔的 轮名=模型)
if [ -n "$ROUND" ]; then
  MODEL=""; for kv in $FLOW_ROLE_MODELS; do case "$kv" in "$ROUND="*) MODEL="${kv#*=}" ;; esac; done
  if [ -n "$MODEL" ]; then ROUNDLINE="- **轮次 / 模型**:$ROUND · model=$MODEL(config FLOW_ROLE_MODELS;Agent 调用带 model=$MODEL)"
  else ROUNDLINE="- **轮次 / 模型**:$ROUND · 继承编排方(FLOW_ROLE_MODELS 未给 $ROUND)"; fi
else ROUNDLINE="- **轮次 / 模型**:(未给 --round;Agent 调用 model 继承编排方)"; fi

# 回件模板:路径由 kit 自己算并印进派单件。手打的插件缓存路径带版本号(…/flow-kit/0.3.0/…),升级即断。
TPL_H="$FLOW_KIT_DIR/skills/protocol/references/handoff-template.md"
TPL_R="$FLOW_KIT_DIR/skills/protocol/references/review-template.md"
case "$ROUND" in
  ①写|③改)        TPLLINE="- **回件模板**(整块照抄):$TPL_H" ;;
  ②A|②B|④A|④B|④*) TPLLINE="- **回件模板**(整块照抄):$TPL_R" ;;
  *)               TPLLINE="- **回件模板**(整块照抄):写 / 改轮 $TPL_H · 审轮 $TPL_R" ;;
esac

# 门整跑只归库独占的轮(F-22,p4e 实测:--db 禁用 的 ②A 拿到的收工段里仍有 flow-gates --reset,与人填段直接冲突,它为此花了一段自证)
if [ "$DB" = 独占 ]; then
  GATELINE="    \`flow-gates --reset > $DIR/.evidence/$ROUND-gates.txt 2>&1; echo RC=\$?\`(每轮至多一次整跑;同一棵树别跑第二遍)"
  GATESTEP=" + flow-gates --reset"
else
  GATELINE="    (库权限 $DB:门整跑不归你 —— 不跑 flow-gates --reset / dbreset / 集成;要读数引上一轮 .evidence/*-gates.txt 的末行)"
  GATESTEP=""
fi
# 冻结 / 收工 / 步骤账行:--dir 给了就连实参印(约定名与 flow-round 同源),没给就印占位写法
# 0.9.0:快照轮(--tree 快照*)不印 flow-manifest verify —— 它判的是活树(基线 root 与副本不同,0.9.0 起在副本里跑直接 FATAL),
#   归编排方 flow-round close;副本里要证的只有「没被动」= 对上一轮交付态 shasum -c。P3-4 四条 A 轴各跑一次副本 verify 报 git 12,
#   与主树同型,那一行从来不是判据。假话门(flow-fact-lint)同理归 close;写 / 改轮自跑那次是给自己的提示,修早一点,不是判据。
if command -v shasum >/dev/null 2>&1; then SHACHK="shasum -a 256 -c"; else SHACHK="sha256sum -c"; fi
ROOTLINE=""; [ -n "$DIR" ] && ROOTLINE="(基线打在 root \`$(git -C "$FLOW_REPO_DIR" rev-parse --show-toplevel)\`;verify 只许在这棵树跑)"
if [ -n "$DIR" ]; then
  case "$TREE" in
    快照*)
      PREV=$(ls -t "$DIR"/.after-*-hashes.txt 2>/dev/null | head -1); [ -n "$PREV" ] || PREV="<上一轮 .after-*-hashes.txt>"
      FREEZELINE="- **冻结**:基线 \`$DIR/.manifest-baseline-$ROUND.txt\` 由编排方 \`flow-round open\` 在活树打$ROOTLINE;你在快照里,**不跑 flow-manifest verify**(它判活树,归编排方收工;在副本里跑会 FATAL)
- **收工三件(命令连实参,照抄)**:
    \`$SHACHK $PREV > $DIR/.evidence/$ROUND-snap-check.txt 2>&1; echo RC=\$?\`(证快照没被动:非 OK 行须为 0;开工先跑一次证同构)
    \`flow-freeze $DIR/.after-$ROUND-hashes.txt\` · 申报清单 \`$DIR/.declared-$ROUND.txt\`(快照轮零改动:= 上一轮的申报清单原样)
$GATELINE
    \`flow-doc-budget $DIR\`
- **步骤账**:\`$DIR/.steps-$ROUND.md\`(每完成一步 \`flow-step done $DIR $ROUND <N> \"<一句>\"\`;你被中断时续轮从第一个未勾步骤接手,勾在文件里不在你脑子里)" ;;
    *)
      FREEZELINE="- **冻结**:基线 \`$DIR/.manifest-baseline-$ROUND.txt\` 由编排方 \`flow-round open\` 在派单后打$ROOTLINE(你开工时它应已存在;不存在就停,别自己打)
- **收工三件(命令连实参,照抄)**:
    \`flow-freeze $DIR/.after-$ROUND-hashes.txt\` · 申报清单 \`$DIR/.declared-$ROUND.txt\`(一行一路径,不许散文;例外行尾 \`# 裁决-N\`)
    \`flow-manifest verify $DIR/.manifest-baseline-$ROUND.txt $DIR/.declared-$ROUND.txt > $DIR/.evidence/$ROUND-manifest-verify.txt 2>&1; echo RC=\$?\`(必须读到 verify OK 或 RED;FATAL 与没跑一律当红)
$GATELINE
    \`flow-fact-lint verify > $DIR/.evidence/$ROUND-factlint.txt 2>&1; echo RC=\$?\`(提示用,判据由编排方收工独立跑)· \`flow-doc-budget $DIR\`
- **步骤账**:\`$DIR/.steps-$ROUND.md\`(每完成一步 \`flow-step done $DIR $ROUND <N> \"<一句>\"\`;你被中断时续轮从第一个未勾步骤接手,勾在文件里不在你脑子里)" ;;
  esac
else
  FREEZELINE="- **冻结**:开工在仓库根跑 \`flow-manifest baseline <流程目录>/.manifest-baseline-<轮名>.txt\`(基线放仓外;收工 verify 由编排方在活树跑,protocol §1)
  ⚠ **baseline 打在编排方停止编辑之后**(protocol §3:打早了会让写轮收到幻影 RED,并教会所有人对 RED 耸肩)
  (未给 --dir:收工命令与步骤账都没印实参;给 --dir 才有断点续跑)"
fi

# 步骤账:--dir 给了且尚无账就建;①写按 open REQ 一条一步,其余轮按固定四步
if [ -n "$DIR" ] && [ ! -f "$DIR/.steps-$ROUND.md" ]; then
  STEPARGS="$TMP/steps"; : > "$STEPARGS"
  case "$ROUND" in
    ①写*)
      # 0.9.0 设计步在前:逐 REQ 增量会把设计锁在第一条测试的形状上,先出整体设计的跑法结果更好(Böckeler 2026-08 的 TDD 评测;n 小,成本一行)
      printf '%s\n' "设计:全部 open REQ 的数据模型 / 接口 / 跨 REQ 边界一次列出,落 $DIR/.evidence/$ROUND-design.txt(②A 核实现有没有偏离它)" >> "$STEPARGS"
      if [ -s "$TMP/sec" ]; then
        LC_ALL=C grep -E "$(flow_req_re).*\[open" "$TMP/sec" | sed -e 's/^[-*[:space:]]*//' -e 's/[[:space:]]*\[open[^]]*\]//' | cut -c1-90 >> "$STEPARGS"
      fi
      [ -s "$STEPARGS" ] || echo "主活:按派单写代码 + 测绿(任务节无 open REQ 行或无 plan 节选;自己 flow-step add 拆步骤)" >> "$STEPARGS"
      printf '%s\n' "回件:索引表 + 甲乙丙丁戊 + 收工读数(边写边落)" "收工核对:flow-freeze + 申报清单 + flow-manifest verify$GATESTEP + flow-fact-lint verify + flow-doc-budget" >> "$STEPARGS" ;;
    ②*|④*)
      printf '%s\n' "装载:读派单 + 上一轮回件首节索引表(按表跳读)" "主活:按本轮清单逐条核,每闭一条追加落盘" "回件:〇甲乙丙丁戊 + 必答四组数(④A 另落三态表)" "收工核对:flow-freeze + 申报清单 + flow-manifest verify(快照零改动也要 verify)$GATESTEP + flow-doc-budget" >> "$STEPARGS" ;;
    *)
      printf '%s\n' "装载:读派单 + 两份审查回件的〇节与丙栏" "主活:逐条 finding 改或反证顶回,每条追加落盘" "回件:索引表每行挂 finding 号 + 收工读数" "收工核对:flow-freeze + 申报清单 + flow-manifest verify$GATESTEP + flow-fact-lint verify + flow-doc-budget" >> "$STEPARGS" ;;
  esac
  # 多行文字进位置参数:逐行读,不靠分词
  set --
  while IFS= read -r l; do [ -n "$l" ] && set -- "$@" "$l"; done < "$STEPARGS"
  flow-step init "$DIR" "$ROUND" "$@" > "$TMP/stepinit" 2>&1 || { cat "$TMP/stepinit" >&2; flow_die "步骤账建立失败"; }
  tail -1 "$TMP/stepinit" >&2
fi

# 渲染期算出的两个字段:三改轮去向(config 定)与规格目录清单(扫描纪律用)
if [ "$FLOW_FIX_BY_WRITER" = 1 ]; then
  FIX="SendMessage 回①写轮本人(断连才起新 agent);审查方结论优先,反证必须带命令"
else
  FIX="另起 agent(宿主无 SendMessage;派单自带上一轮回件索引表,按表跳读);审查方结论优先,反证必须带命令"
fi
SPECS=""; for d in $FLOW_SPEC_DIRS; do SPECS="$SPECS $d/"; done; SPECS="${SPECS# }"

if [ -n "$LANE" ]; then
  HEAD="## 派单必带块 —— $TASK · 合并批:只做支合并 + 跨检,不带功能触面(flow-dispatch 生成 $(date +%F);触面清单 $LANE;生成段勿手改,要改重跑)"
else
  HEAD="## 派单必带块 —— $TASK(flow-dispatch 生成 $(date +%F);生成段勿手改,要改重跑)"
fi

cat <<HDR
<!-- flow:gen-begin -->
$HEAD

- **树权限**:$TREE(protocol §3:只读 agent 一律快照;活树是变异轴独占资源)
- **库权限**:$DB(protocol §3:库是单点,dbreset 门任何时刻只许一个持有者)
- **核心库写权限面**:$CORE
- **写权限面 · 许写**(= 触面,与 .face-<轮名>.txt 同源;收工 flow-round close 判 申报 ⊆ 面,越面 RED,例外只走申报行尾 \`# 裁决-N\`):$FACE_TXT
- **裁决号段**:从 $SEQ 起
$ROUNDLINE
$TPLLINE
$FREEZELINE
- **扫描纪律**:全仓口径判据须 \`command grep\` 或显式含 $SPECS(protocol §4 范围轴);零命中先过非空转(protocol §4)
- **假话门**:新增 RED 零才许交付,判据由编排方收工独立跑(flow-round close);你自跑 \`flow-fact-lint verify\` 是为了修早一点;基线存量归收尾轮
- **移交件预算**:回件**自写**部分 ≤$FLOW_DOC_BUDGET_FILE 行且 ≤$FLOW_DOC_BUDGET_SELF 字节(本派单件的生成段由 \`<!-- flow:gen-* -->\` 括起,不计进你的预算;
  超限首部 \`budget-ok:<理由>\` 显式带过);命令全量输出落 <流程目录>/.evidence/,件内只贴摘录+路径;引上游用指针(裁决号/文件+节号)不抄正文;收工编排方跑 \`flow-doc-budget\`(protocol §5)
  ⚠ 回件是你逐字打出来的(复审轴 21–34% 的墙钟耗在写回件上):少写一段的收益比少读十个文件大得多。
- **读取纪律**:上一轮回件先读首节「改动索引表」,按表只读文件区间;整读一个文件要在回件里给一行理由;
  定位用 LSP(先 ToolSearch select:LSP)/ \`grep -n\`,不用 cat 找;plan 只读本块的任务书节选,账本只读本块的必读段
- **工具纪律**(一次响应只发得出一个工具块;读批量与调用每轮由 flow-usage 记账):**要批量就把多条命令合进同一个 Bash**(\`cmd1; echo ===; cmd2\`);
  flow-* 命令与门的输出 \`> <流程目录>/.evidence/<名>.txt; rc=\$?\`,判读只贴末行读数 + RC(末行为此固定可 grep),全量不 cat 进上下文;自造扫描仍逐行判
- **证据源封闭**:证据只来自树、上游 spec、本批流程目录;会话记录(~/.claude/projects/**/*.jsonl)与 tool-results 不是证据源,不读不引
  ⚠ **边做边落盘**:进程中途死于 API 断连时,**没落盘的一律全丢**;
  攒到最后一次性写 = 拿整轮的工作量赌连接不断。已得结论每隔一段就写进回件文件。
- **闭环**:回件落文件即可,不必回信;转达走编排方(protocol §1);残留按 protocol §2 三级标级,不标按阻塞
- 回件边写边落:每闭一条 finding 就追加落盘,不许攒到收工一次写
- 三改轮:$FIX
HDR

# 节选打印:按轴 + 字节封顶(节头 + outline + REQ 行永远印;正文只给①写,且超封顶时只留节尾)
print_excerpt() {
  REQ_RE=$(flow_req_re)
  SECB=$(wc -c < "$TMP/sec" | tr -d ' ')
  case "$ROUND" in
    ②*|③*|④*) AXIS=1 ;;
    *) AXIS=0 ;;
  esac
  if [ "$AXIS" = 0 ] && [ "$SECB" -le "$FLOW_DISPATCH_EXCERPT_BYTES" ]; then cat "$TMP/sec"; return 0; fi
  if [ "$AXIS" = 1 ]; then echo "(本轮 $ROUND 只给 outline + REQ 行:你读的是上一轮回件的索引表,不是任务书正文;正文按「文件 + 行号」指针按需读)"
  else echo "(节 $SECB 字节 > 封顶 $FLOW_DISPATCH_EXCERPT_BYTES:只印 节头 + outline + REQ 行 + 节尾;中间按「文件 + 行号」指针按需读)"; fi
  echo ""; echo "#### 节头"
  # 节头 ≤1500 字节:到第一个 ### 或第一条 REQ 行为止(没有 ### 的节会把整节当节头,[done] 行就从这里漏回来);按行累计,最后一行按字边界截(head -c 会劈开汉字 ⟹ 非法 UTF-8,F-9 同族)
  LC_ALL=C awk -v re="$REQ_RE" 'NR>1 && (/^###/ || $0 ~ re){exit} {print}' "$TMP/sec" | LC_ALL=C awk "$(flow_awk_utrunc)"'{ if (n + length($0) + 1 > 1500) { print utrunc($0, 1500 - n); exit } print; n += length($0) + 1 }'
  echo ""; echo "#### outline(行号是 $PLAN 的)"
  awk -v s="$SECS" '/^###/{printf "L%d: %s\n", s+NR-1, $0}' "$TMP/sec"
  # [done] 的 REQ 行不印(0.7.0):p4e 实测一节 21 条 REQ 里 14 条 done 占派单 10.3 KB,八个 agent 各读一遍;要看按行号 sed -n
  echo ""; echo "#### REQ 行(open / deferred,带行号;[done] $NDONE 条不印,整节 L$SECS–L$SECE 按需 sed -n 读)"
  LC_ALL=C awk -v s="$SECS" -v re="$REQ_RE" '$0 ~ re && $0 !~ /\[done/ {printf "L%d: %s\n", s+NR-1, $0}' "$TMP/sec"
  if [ "$AXIS" = 0 ]; then
    # 节尾:本刀的落位段按惯例住在节尾;给剩余预算(封顶减去已印的节头 1.5 KB + outline + REQ 行),整行对齐
    used=$(( 1500 + $(awk '/^###/' "$TMP/sec" | wc -c | tr -d ' ') + $(LC_ALL=C grep -E "$REQ_RE" "$TMP/sec" | LC_ALL=C grep -v '\[done' | wc -c | tr -d ' ') ))
    rem=$(( FLOW_DISPATCH_EXCERPT_BYTES - used )); [ "$rem" -lt 2000 ] && rem=2000
    tail -c "$rem" "$TMP/sec" | sed 1d > "$TMP/tail"
    ntail=$(wc -l < "$TMP/tail" | tr -d ' '); nsec=$(wc -l < "$TMP/sec" | tr -d ' ')
    echo ""; echo "#### 节尾(L$((SECS + nsec - ntail))–L$SECE;L$SECS–L$((SECS + nsec - ntail - 1)) 未印,按需 sed -n 读)"
    cat "$TMP/tail"
  fi
}
if [ -n "$PLAN" ]; then
  if [ -n "$SECS" ]; then
    echo ""
    echo "### 任务书节选(同源摘取:$PLAN L$SECS–$SECE;REQ open $NOPEN · done $NDONE · deferred $NDEF,open 上限 $FLOW_REQ_CAP;plan 其余不读,引上游用「文件 + 节号」指针)"
    print_excerpt
    if [ "$NOPEN" -gt "$FLOW_REQ_CAP" ]; then
      if [ -n "$CAPOK" ]; then
        echo ""
        echo "⚠ **任务节 open REQ $NOPEN 条 > 上限 $FLOW_REQ_CAP,--cap-ok 显式带过**。理由(进派单,由复审核):$CAPOK"
      else
        echo "" >&2
        echo "RED: 任务节 open REQ $NOPEN 条 > 上限 $FLOW_REQ_CAP —— ①写是最长的会话,携带成本随轮数平方长;拆任务,确要整批做加 --cap-ok <理由> 重跑" >&2
        exit 3
      fi
    fi
  else
    echo ""
    echo "⚠ WARN: plan 里找不到节 \`## $TASK\` —— 节选缺失,agent 只能整读 plan;先把任务节落成 \`## $TASK …\` 再重跑"
  fi
fi

cat <<DH

### 欠账必读(同源生成:下面的输出就是紧邻命令的实跑结果,RC=$DRC)
命令:\`$CMD\`
路由条数:**$NDEBT**(其中 owner 归 $TASK 的 **$NOWN** 条;owner 上限 $FLOW_DEBT_CAP,必读总量 >$FLOW_DEBT_WARN 仅提醒)
DH
cat "$TMP/debts"

if [ "$NDEBT" -gt "$FLOW_DEBT_WARN" ]; then
  echo ""
  echo "⚠ WARN: 必读 $NDEBT 条偏重(阅读/复审 diff 负担)—— 考虑收窄触面参数,或核对是否该拆任务。"
fi
if [ "$NOWN" -gt "$FLOW_DEBT_CAP" ]; then
  if [ -n "$CAPOK" ]; then
    echo ""
    echo "⚠ **owner 归 $TASK 的欠账 $NOWN 条 > 上限 $FLOW_DEBT_CAP,--cap-ok 显式带过**。理由(进派单,由复审核):$CAPOK"
  else
    echo "" >&2
    echo "RED: owner 归 $TASK 的欠账 $NOWN 条 > 上限 $FLOW_DEBT_CAP —— 拆任务或专开还账批次;确要整批背,加 --cap-ok <理由> 重跑(理由会印进派单)" >&2
    exit 3
  fi
fi

if [ -n "$PLAN" ]; then
  cat <<RH

### 接收位覆盖(同源生成,RC=$RRC)
命令:\`flow-receipts $PLAN $TASK\`
RH
  cat "$TMP/rcpt"
fi

cat <<FT
<!-- flow:gen-end -->

### 编排方待填(生成器管不到的判断项)
- 禁写面:逐条写明(许写已由生成段从触面印出,别再手写一份;写「其余不许」不算)
- 交付判据与任务书之外的裁决(任务书正文已在节选段,不再抄;①写不跑变异电池,变异归 ②B 与 ④B)
- 自报三处「最没把握」的要求(①写轮)
- ④ 的必闭每条带:可原样重跑的复现命令 + 期望读数 + **一份可 \`git apply\` 的 patch**(落 \`$DIR/.evidence/$ROUND-micro-<裁决号>.patch\`,生成用 \`git -c core.quotepath=false diff\`)。
  行数与性质**不由审方估**,由 \`flow-micro <patch>... --face $DIR/.face-<③改轮名>.txt\` 从 patch 量(新增行求和 · 路径与改动行核性质 · 面内);
  末行 MICRO OK ⟹ 编排方 \`--apply --freeze <③改的 .after-*-hashes.txt>\` 落笔(占裁决号)+ 复跑④写下的复现命令对读数,不起 ③改二;
  MICRO RED(有生产 / 面外 / 合计新增 > $FLOW_MICRO_FIX_LINES)⟹ 整批走 ③改二。**没附 patch 的条目一律不算微改。**
- 本轮**必读清单**(移交件按件点名;目录其余 = 旁证按需读,protocol §5)
- 若并行:H1/H2 隔离条件逐条核($SPECS 手工 cp / DB 单点 / 文件层不相交 / 号段)
FT
exit 0
