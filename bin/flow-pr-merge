#!/bin/sh
# flow-pr-merge —— 「CI 绿即合」的机械执行。
# 事故:`gh pr checks --watch` 在 CI 尚未注册任何 check 时立即 RC=1,而 merge 用 `;` 接在后面 ⟹ 合并没被 CI 门住。
#   §J 硬规矩 3 的动作版:判据与动作之间只许 `&&`,且判据要先等到「有 check 可判」。
# 用法: flow-pr-merge <PR号> [--subject <合并标题>] [--wait-register <秒,默认 300>] [--background]
#       flow-pr-merge --help
# 步骤:① 轮询到 PR 至少注册了一个 check(否则「没有 check」与「全绿」在 --watch 的退出码上分不开)
#       ② gh pr checks --watch --fail-fast  ③ 逐条核 conclusion 全为 SUCCESS(SKIPPED 不算)  ④ 才 merge(策略 = FLOW_MERGE_STRATEGY,不删分支)
#       ③b 等 GitHub 把 mergeStateStatus 算成 CLEAN / HAS_HOOKS 再 merge(F-19:CI 绿当刻就发 merge,GitHub 异步还没算完 ⟹ 假 BLOCKED,
#          几十秒后同一条命令一次就过;编排方为此手工重试 + 210 s 轮询)。BLOCKED / DIRTY / BEHIND / DRAFT 才是真不可合。
# 任一步不满足 ⟹ 不合并,RC=1,末行 `PR-MERGE BLOCKED …`。合并成功末行 `PR-MERGE DONE …`。
#   merge 那一步的输出**不许丢**(0.8.1,§J 硬规矩①「探测器输出不截断」):只报 RC 的话,
#   「重跑就好」(GitHub 异步没算完)与「真被分支保护挡了」在读数上完全一样,而这条失败本身是间歇性的。
# --background:整个等待+合并循环 nohup 脱管跑,日志落 FLOW_FLOW_DIR/.pr-merge-<PR>.log,当场打印日志路径并 RC=0,
#   让编排方把等 CI 与收工核对重叠起来;结论看日志末行(grep 'PR-MERGE \(DONE\|BLOCKED\)')。
# 读的配置:FLOW_REPO_DIR FLOW_MAIN_BRANCH FLOW_MERGE_STRATEGY FLOW_FLOW_DIR_PATH
set -u
usage() { echo "用法: flow-pr-merge <PR号> [--subject <标题>] [--wait-register <秒>] [--background] | --help"; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
flow_load_config
[ $# -ge 1 ] || { usage >&2; exit 2; }
N="$1"; shift
SUBJ=""; WAIT=300; BG=0
while [ $# -gt 0 ]; do
  case "$1" in
    --subject) [ $# -ge 2 ] || flow_die "--subject 缺值"; SUBJ="$2"; shift ;;
    --wait-register) [ $# -ge 2 ] || flow_die "--wait-register 缺值"; WAIT="$2"; shift ;;
    --background) BG=1 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$BG" = 1 ]; then
  mkdir -p "$FLOW_FLOW_DIR_PATH"
  LOG="$FLOW_FLOW_DIR_PATH/.pr-merge-$N.log"
  set -- "$N"
  [ -n "$SUBJ" ] && set -- "$@" --subject "$SUBJ"
  set -- "$@" --wait-register "$WAIT"
  nohup "$SELF" "$@" > "$LOG" 2>&1 &
  echo "PR-MERGE BACKGROUND: PR #$N 脱管等 CI(pid $!),日志 $LOG —— 结论看末行 PR-MERGE DONE|BLOCKED"
  exit 0
fi

cd "$FLOW_REPO_DIR" || exit 2
t=0
while :; do
  n=$(gh pr view "$N" --json statusCheckRollup --jq '.statusCheckRollup | length' 2>/dev/null || echo 0)
  [ "${n:-0}" -ge 1 ] && break
  [ "$t" -ge "$WAIT" ] && { echo "PR-MERGE BLOCKED: ${WAIT}s 内 PR #$N 没有注册任何 check(CI 没起来 ≠ CI 绿)"; exit 1; }
  sleep 10; t=$((t+10))
done
echo "checks registered: $n(等待 ${t}s)"
gh pr checks "$N" --watch --fail-fast > /dev/null 2>&1; wrc=$?
echo "watch RC=$wrc"
concl=$(gh pr view "$N" --json statusCheckRollup --jq '.statusCheckRollup[] | "\(.name)=\(.conclusion)"')
printf '%s\n' "$concl"
bad=$(printf '%s\n' "$concl" | grep -vc '=SUCCESS$')
if [ "$wrc" != 0 ] || [ "$bad" != 0 ]; then echo "PR-MERGE BLOCKED: 有 check 未 SUCCESS(watch RC=$wrc,非 SUCCESS 条数 $bad)—— 停在 PR,不合并"; exit 1; fi
# ③b mergeStateStatus:UNKNOWN / UNSTABLE 是「还没算完」,等;CLEAN / HAS_HOOKS 才发;其余是真不可合
t=0; ms=UNKNOWN
while :; do
  ms=$(gh pr view "$N" --json mergeStateStatus --jq .mergeStateStatus 2>/dev/null || echo UNKNOWN)
  case "$ms" in
    CLEAN|HAS_HOOKS) break ;;
    BLOCKED|DIRTY|BEHIND|DRAFT) echo "PR-MERGE BLOCKED: mergeStateStatus=$ms(check 全绿但 GitHub 判不可合:BEHIND 先更新分支,DIRTY 有冲突,BLOCKED 看分支保护)"; exit 1 ;;
  esac
  [ "$t" -ge 180 ] && { echo "PR-MERGE BLOCKED: 180s 内 mergeStateStatus 仍是 $ms(GitHub 异步没算完;重跑本命令即可,不是 CI 红)"; exit 1; }
  sleep 10; t=$((t+10))
done
echo "mergeStateStatus=$ms(等待 ${t}s)"
# FLOW_MERGE_STRATEGY 故意不加引号:它是 gh pr merge 的策略参数(--merge / --squash / --rebase),要按词拆
MO="$(flow_tmpdir)/flow-pr-merge-$N.$$"
if [ -n "$SUBJ" ]; then gh pr merge "$N" $FLOW_MERGE_STRATEGY --subject "$SUBJ" > "$MO" 2>&1; mrc=$?; else gh pr merge "$N" $FLOW_MERGE_STRATEGY > "$MO" 2>&1; mrc=$?; fi
if [ "$mrc" != 0 ]; then
  echo "PR-MERGE BLOCKED: gh pr merge RC=$mrc —— gh 原话(全量,不截断):"
  cat "$MO"; rm -f "$MO"; exit 1
fi
rm -f "$MO"
git fetch origin --quiet
echo "PR-MERGE DONE: PR #$N → $FLOW_MAIN_BRANCH $(git rev-parse --short "origin/$FLOW_MAIN_BRANCH")"
