#!/bin/sh
# flow-freeze —— 冻结一棵工作树,产出完整哈希清单(shasum -c 体例)。1.0.0 起主体入库为 `flow_freeze_to`,本命令只剩壳,留作排障入口。
#
# 为什么存在:中断时曾用 `git status` 枚举改动来建清单,漏掉了 gitignore 区里的规格文件 —— git 根本看不见它。
# 修法不是「检测哪个规格变了」(gitignore 的文件没有 HEAD 可比),而是**把整个规格目录无条件纳入清单** —— 漏不掉,因为不做选择。
# 1.0.0:冻结归编排方 —— `flow-round close` 在 BETWEEN OK 之后打 `.after-<轮名>-hashes.txt`,`flow-micro --apply` 落笔后重打;
#   agent 不再自跑(它自跑的那次从来不是判据,只是收工仪式里的一个请求)。
#
# 用法: flow-freeze <输出文件(绝对路径)>
# 仓根取自 FLOW_REPO_DIR(库函数自己 cd,不依赖调用方 cwd);规格目录取自 FLOW_SPEC_DIRS(空格分隔,仓相对)。
# FLOW_SPEC_UNTRACKED=1 才走规格目录轴(规格目录活在 git 外);=0 只走 git 轴。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

[ $# -ge 1 ] || { echo "用法: flow-freeze <输出文件(绝对路径)>" >&2; exit 2; }
flow_freeze_to "$1"; rc=$?
[ "$rc" = 0 ] || exit "$rc"
if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then
  NS=0; for d in $FLOW_SPEC_DIRS; do c=$(grep -cF "  $d/" "$1" || true); NS=$((NS + c)); done
  echo "  其中规格目录 [$FLOW_SPEC_DIRS] $NS 行(这些 git status 看不见)"
else
  echo "  只有 git 轴(FLOW_SPEC_UNTRACKED=0,规格入库)"
fi
echo "  HEAD = $(git -C "$FLOW_REPO_DIR" log --oneline -1 2>/dev/null || echo "(无提交)")"
if command -v shasum >/dev/null 2>&1; then chk="shasum -a 256 -c"; else chk="sha256sum -c"; fi
echo "校验: cd $FLOW_REPO_DIR && $chk $1"
exit 0
