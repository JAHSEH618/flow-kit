#!/bin/sh
# flow-usage —— 轮数账自动填:从 Claude Code transcripts 按轮次汇总 轮数 / 携带 token / 输出 token / 调用每轮 / 时长 / 模型。
# 病根:轮数账的 token 列从来没填过,§5「只比不涨」的检验判据一直是空的;真数据一直躺在 transcripts 里(每条 assistant 行带 message.usage)。
# 会话归属:sub-agent 的第一条 user 消息里含流程目录绝对路径(三行 prompt 的第一行就是它)⟹ 归本批;
#   轮名先按「的 <轮名> agent」这个模式取(三行 prompt 首行的固定写法);取不到才退到「按 ROLES 顺序找第一个命中」。
#     ⚠ 别按「最早出现的位置」取:批次名里带圈码时(「P4 批次②」)全部 agent 会被归成②,实测五轮全归一行,轮数账只能手填。
#   ③改回①本人时并入①写行(同一会话)。
#   含这些 sub-agent 的父会话 = 编排方,单独一行(它若跨批,数字含别批的活,备注标「跨批」由人判)。
# 计数:轮 = 去重 message.id 的 assistant 消息数(= 唯一 requestId 数,实测一一对应);携带 = Σ(input + cache_creation + cache_read);调用 = tool_use 块数(按 id 去重);
#   当量 = input×1 + cache_creation×1.25 + cache_read×0.1 + output×5(以 input 单价为 1,供批间只比不涨;不是账单)。
#   ⚠ 同一 message.id 的多条记录**逐字段取 max**,不许留第一条(0.5.0 修):一次响应按 apiBlockIndex 拆成多条,
#     第一条通常是 thinking 块、output_tokens 只有 2–6。留第一条会把输出列低估约 3 倍(①写实测 60,899 而真值 200,275),
#     而输出列是唯一指向墙钟去向的那一列 —— 实测 延迟(s) ≈ 1.5 + 1.4×(上下文/100k) + 1.3×(输出/100 token)。
#   读批量 = 纯读调用里点到的不同路径数 / 纯读调用数。一次响应只发得出一个工具块(实测五轴 0.99–1.09 调用/轮,那是响应形态),
#     所以「批量」只能靠一条 Bash 串多条命令;该量的是这个,不是「调用/轮」。
# 检验判据(只 WARN,RC 不变 —— 轮数账是账不是门):单**会话**请求 > FLOW_TURN_CAP(按会话不按轴:续轮单算,否则有续轮必红);读批量 < 2 路径/读调用;
#   单次工具调用 ≥ FLOW_STALL_SEC 记「卡顿」(p4d 实测 ②A ②B 各挂 600 s 整、同一秒放行,输出正常 —— harness 侧,不是脚本慢;看不见就会记到 flow 头上)。
# 墙钟归因(0.6.0):每个会话拆 生成(首块 − 上一事件 + 流式)/ 工具(结果 − 末块)/ 空等(> 15 min 无事件:人或日界)/ 卡顿次数;
#   编排方另出「独占关键路径」= 它的请求区间里没有任何 sub-agent 在跑的那部分(两批实测 70–100 min,ShipLedger 占关键路径一半),
#   与「输出去向」(状态档 / 派单 / 报告 / flow-* / 门自跑 / git / 读 / 轮询 …,按输出 token)—— 输出是墙钟的十倍杠杆,先砍它。
# 角色识别(0.6.0):「的」之后第一个含轮名的短语定轴(容忍 ** 与空格),短语带 续 / r2 记「<轮>续」、带 定点 记「<轮>定点」;
#   短语无轮名时 合并+跨检 ⟹ 合并跨检、调研 ⟹ 调研;都没有才退到全文顺序扫。旧正则被「的 **④B · 变异复验轴**」打败后 ②B/④B 曾并进错行。
#   编排方按**本批时间窗**切:窗 = 父会话里提到本批流程目录路径的首末时间戳 ∪ 本批 sub-agent 的时段。
#     前半段是关键:开工清账与派单装配发生在第一个 agent 起来**之前**,只按 sub-agent 时段切会把它整段丢掉。
#     父会话一次都没提到流程目录 ⟹ 不切窗(备注写明),跨批时数字偏大 —— 但「切了却切错」比「没切」更坏。
# 用法: flow-usage <流程目录(绝对)> [--write]      --write 另写 <流程目录>/.usage.md(dotfile,不进 doc-budget 热路径)
# 末行固定:`USAGE OK: N 会话 / M 轮`;零会话命中 ⟹ FATAL RC=2(空集不算绿:「没花 token」与「没扫到」不许同型)。
# 读的配置:FLOW_TRANSCRIPTS_DIR(默认 ~/.claude/projects;结构 <项目>/<会话>/subagents/agent-*.jsonl)FLOW_TURN_CAP
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config
DIR="${1:-}"; WRITE="${2:-}"
[ -n "$DIR" ] || flow_die "用法: flow-usage <流程目录(绝对)> [--write]"
case "$DIR" in /*) ;; *) flow_die "流程目录须绝对路径: $DIR" ;; esac
[ -d "$DIR" ] || flow_die "流程目录不存在: $DIR"
case "$WRITE" in ""|--write) ;; *) flow_die "未知参数 $WRITE" ;; esac
[ -d "$FLOW_TRANSCRIPTS_DIR" ] || flow_die "transcripts 根不存在: $FLOW_TRANSCRIPTS_DIR(FLOW_TRANSCRIPTS_DIR)"

python3 - "$DIR" "$FLOW_TRANSCRIPTS_DIR" "$WRITE" <<'PY'
import sys, os, re, json, glob, collections, datetime
flowdir, tdir, write = sys.argv[1:4]
flowdir = flowdir.rstrip('/')
ROLES = ['④A', '④B', '②A', '②B', '①写', '③改', '④复审', '④', '②', '①', '③']
LABEL = {'④复审': '④(旧单段)', '④': '④(旧单段)', '①': '①写', '③': '③改'}
ORDER = ['①写', '①写续', '②A', '②A续', '②B', '②B续', '②', '③改', '③改续', '④A', '④A续', '④B', '④B续', '④B定点', '④(旧单段)', '合并跨检', '调研', '未识别', '编排方']
TURN_CAP = int(os.environ.get('FLOW_TURN_CAP') or 120)
STALL = int(os.environ.get('FLOW_STALL_SEC') or 300)
IDLE = 900          # > 15 min 无事件 = 空等(人 / 日界),不计进生成或工具
READ_BATCH_FLOOR = 2.0

def first_user_text(path):
    with open(path, encoding='utf-8', errors='replace') as fh:
        for line in fh:
            try: o = json.loads(line)
            except Exception: continue
            if o.get('type') != 'user': continue
            c = (o.get('message') or {}).get('content')
            if isinstance(c, str): return c
            if isinstance(c, list): return ' '.join(b.get('text', '') for b in c if isinstance(b, dict) and b.get('type') == 'text')
            return ''
    return ''

ROLE_RE = re.compile(r'(④A|④B|②A|②B|①写|③改|④复审|④|②|①|③)')
def role_of(txt):
    """「的」之后第一个含轮名的短语定轴(容忍 ** 与空格);短语带 续 / r2 记「<轮>续」、带 定点 记「<轮>定点」。
    实测编排方写的是「的 **④B · 变异复验轴**(与 ④A 并行」—— 旧正则要求「的 ④B…agent」12 字内,被 ** 打败后退化成全文扫,先撞到 ④A。"""
    head = txt[:400]
    base = None; phrase = ''
    for m in re.finditer(r'的[\s*]*([^\s*(（,，。;;:：]{1,24})', head):
        ph = m.group(1); r = ROLE_RE.search(ph)
        if r: base = LABEL.get(r.group(1), r.group(1)); phrase = ph; break
    if base is None:
        if '合并' in head and '跨检' in head: return '合并跨检'
        if '调研' in head: return '调研'
        for r in ROLES:
            if r in head: base = LABEL.get(r, r); break
        if base is None: return '未识别'
        # 退化路径:轮名不在「的」后短语里(如「②A 对外事实轴的**续轮**」),续 / r2 只看前 200 字
        if re.search(r'续轮|-r2|续', head[:200]): return base + '续'
    if '续' in phrase or 'r2' in phrase.lower(): return base + '续'
    if '定点' in phrase: return base + '定点'
    return base

def ts(s):
    return datetime.datetime.fromisoformat(s.replace('Z', '+00:00'))

# 读批量:一个「纯读调用」里点到几个不同路径。语言中立(只认 shell 命令头与路径形状),不进 config。
READ_HEADS = {'cat', 'sed', 'grep', 'egrep', 'fgrep', 'rg', 'head', 'tail', 'awk', 'nl', 'wc', 'ls', 'find',
              'stat', 'diff', 'comm', 'file', 'cut', 'sort', 'uniq', 'tr', 'column', 'jq', 'shasum',
              'md5sum', 'sha256sum', 'od', 'xxd', 'basename', 'dirname', 'realpath', 'readlink'}
NEUTRAL = {'cd', 'echo', 'printf', 'true', 'test', '[', ':', 'pwd', 'command'}
SEG_RE = re.compile(r'\|\||&&|[|;\n]')
ASSIGN_RE = re.compile(r'^(?:[A-Za-z_][A-Za-z0-9_]*=(?:"[^"]*"|\'[^\']*\'|[^\s;|&]*)\s*)+')
TOK_RE = re.compile(r'[^\s\'"();|&<>]+')

def read_shape(cmd):
    """(是不是纯读调用, 这次点到的不同路径数)。写重定向 / 非读命令头 ⟹ 不算读调用(宁可少算)。"""
    probe = cmd.replace('2>&1', '').replace('>&1', '').replace('>&2', '')
    probe = re.sub(r'>>?\s*/dev/null', '', probe)
    if '>' in probe: return (False, 0)
    nread = 0
    for seg in SEG_RE.split(cmd):
        seg = seg.strip().lstrip('( ')
        if not seg: continue
        seg = ASSIGN_RE.sub('', seg, count=1)
        if not seg.strip(): continue
        head = os.path.basename(seg.split()[0])
        if head in READ_HEADS: nread += 1
        elif head not in NEUTRAL: return (False, 0)
    if nread == 0: return (False, 0)
    paths = set()
    for t in TOK_RE.findall(cmd):
        if t.startswith('-') or t.startswith('/dev/'): continue
        if '=' in t: t = t.split('=', 1)[1]
        if '/' in t or re.fullmatch(r'[\w@.~-]+\.[A-Za-z][\w]{0,5}', t): paths.add(t.rstrip('/'))
    return (True, len(paths))

FLOWCMD_RE = re.compile(r'flow-(gates|close|freeze|manifest|dispatch|ledger|usage|doc-budget|fact-lint|route-debts|render-index|trace|clear-map-debt|pr-merge|freshness|receipts|config|review-diff|merge-lane|round|step|settings)')
def category(name, inp):
    """编排方请求的输出去向(按第一个工具块)。"""
    if name is None: return '报告(纯文本给用户)'
    if name == 'Bash':
        c = inp.get('command', '') or ''
        m = re.search(r'(?:cat|tee)\s*>>?\s*([^\s<]+)\s*<<', c) or re.search(r"open\(['\"]([^'\"]+)['\"],\s*['\"][wa]", c) or re.search(r"\bp='([^']+)'", c)
        if m:
            f = os.path.basename(m.group(1))
            if 'ORCH-STATE' in f: return '状态档'
            if re.search(r'dispatch|TASK', f): return '派单(手写)'
            if re.search(r'handoff|review|verdicts', f): return '回件/三态表'
            return '写文件'
        if FLOWCMD_RE.search(c): return 'flow-* 命令'
        if re.search(r'\bpnpm\b|\bvitest\b|check\.sh|\bnpx\b|\bnpm (test|run)', c): return '门(自跑)'
        if re.search(r'\bgit\b|\bgh\b', c): return 'git/gh'
        if re.search(r'\bsleep\b|ls -t|mtime|\.evidence', c): return '轮询/看落盘'
        if re.search(r'\b(cat|sed|grep|head|tail|awk|wc|ls|find|rg)\b', c): return '读'
        return '其它 Bash'
    if name in ('Write', 'Edit'):
        f = os.path.basename(inp.get('file_path', '') or '')
        if 'ORCH-STATE' in f: return '状态档'
        if re.search(r'dispatch|TASK', f): return '派单(手写)'
        return '写文件'
    if name == 'Agent': return '派单 prompt'
    if name == 'SendMessage': return 'SendMessage'
    if name == 'AskUserQuestion': return '问用户'
    return name

def stats(path, win=None):
    """一个会话的账:token 四项(同 message.id 逐字段取 max)· 请求数 · 调用数 · 读批量 · 墙钟四段 · 卡顿清单 · 活动区间 · 输出去向。"""
    reqs = {}; order = []; tools = set(); models = collections.Counter()
    nread = 0; npath = 0
    events = []   # (ts, kind, message.id)  kind ∈ assistant / tool_result / human
    with open(path, encoding='utf-8', errors='replace') as fh:
        for line in fh:
            try: o = json.loads(line)
            except Exception: continue
            if not o.get('timestamp'): continue
            try: t = ts(o['timestamp'])
            except Exception: continue
            if win and not (win[0] <= t <= win[1]): continue
            typ = o.get('type')
            if typ == 'user':
                c = (o.get('message') or {}).get('content')
                is_tr = isinstance(c, list) and any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in c)
                events.append((t, 'tool_result' if is_tr else 'human', None))
                continue
            if typ != 'assistant': continue
            m = o.get('message') or {}; u = m.get('usage') or {}; mid = m.get('id')
            if not mid: continue
            r = reqs.get(mid)
            if r is None:
                r = {'first': t, 'last': t, 'u': (0, 0, 0, 0), 'tu': None}; reqs[mid] = r; order.append(mid)
                events.append((t, 'assistant', mid))
            r['last'] = max(r['last'], t)
            # ⚠ 一次 API 响应按 apiBlockIndex 拆成多条记录,首条通常是 thinking 块、output 只有 2–6;逐字段取 max(0.5.0 修,此前输出列低估 3 倍)
            if u:
                v = (u.get('input_tokens', 0) or 0, u.get('cache_creation_input_tokens', 0) or 0,
                     u.get('cache_read_input_tokens', 0) or 0, u.get('output_tokens', 0) or 0)
                r['u'] = tuple(max(a, b) for a, b in zip(r['u'], v))
            if m.get('model'): models[m['model']] += 1
            for b in m.get('content') or []:
                if isinstance(b, dict) and b.get('type') == 'tool_use':
                    tid = b.get('id') or (mid, o.get('apiBlockIndex'))
                    if tid in tools: continue
                    tools.add(tid)
                    i = b.get('input') or {}
                    if r['tu'] is None:
                        c = (i.get('command') or i.get('file_path') or i.get('description') or '') if isinstance(i, dict) else ''
                        r['tu'] = (b.get('name'), i, str(c).strip().replace('\n', ' ')[:60])
                    if b.get('name') == 'Bash':
                        isread, np = read_shape(i.get('command', '') or '')
                        if isread: nread += 1; npath += np
                    elif b.get('name') == 'Read':
                        nread += 1; npath += 1
    # 墙钟四段:按事件序推。生成 = 首块 − 上一事件末 + 流式(末块 − 首块);工具 = 结果 − 末块;>15 min 无事件 = 空等
    events.sort(key=lambda e: e[0])
    gen = tool = idle = 0.0; stalls = []; intervals = []
    prev_end = None; prev_kind = None; prev_mid = None; cur = None
    for t, kind, mid in events:
        end = max(t, reqs[mid]['last']) if (kind == 'assistant' and mid in reqs) else t
        if prev_end is not None:
            d = (t - prev_end).total_seconds()
            if d < 0: d = 0.0
            if d > IDLE:
                idle += d
                if cur: intervals.append(tuple(cur)); cur = None
            elif kind == 'assistant':
                gen += d
            elif kind == 'tool_result':
                tool += d
                if prev_kind == 'assistant' and d >= STALL:
                    stalls.append((prev_end, d, (reqs[prev_mid]['tu'] or (None, None, ''))[2] if prev_mid in reqs else ''))
            else:
                idle += d
        if kind == 'assistant' and mid in reqs: gen += (end - t).total_seconds()
        if cur is None: cur = [t, end]
        cur[1] = max(cur[1], end)
        prev_end = end; prev_kind = kind; prev_mid = mid
    if cur: intervals.append(tuple(cur))
    dur = (events[-1][0] - events[0][0]).total_seconds() if events else 0.0
    inp = sum(reqs[m]['u'][0] for m in order); cw = sum(reqs[m]['u'][1] for m in order)
    cr = sum(reqs[m]['u'][2] for m in order); out = sum(reqs[m]['u'][3] for m in order)
    cats = collections.Counter()
    for m in order:
        tu = reqs[m]['tu']
        cats[category(tu[0], tu[1]) if tu else category(None, {})] += reqs[m]['u'][3]
    # 编排方独占用:每个请求的区间 = (上一事件末 → 本请求末块)
    spans = []; pe = None
    for t, kind, mid in events:
        end = max(t, reqs[mid]['last']) if (kind == 'assistant' and mid in reqs) else t
        if kind == 'assistant' and mid in reqs:
            a = pe if (pe is not None and (t - pe).total_seconds() <= IDLE) else t
            spans.append((a, end))
        pe = end
    return dict(turns=len(order), inp=inp, cw=cw, cr=cr, out=out, carried=inp + cw + cr,
                eq=inp + 1.25 * cw + 0.1 * cr + 5 * out, tools=len(tools), dur=dur,
                nread=nread, npath=npath, gen=gen, tool=tool, idle=idle, stalls=stalls, intervals=intervals,
                spans=spans, cats=cats,
                model=models.most_common(1)[0][0] if models else '?', n=1, sid=os.path.basename(path).replace('.jsonl', '')[:14])

files = glob.glob(os.path.join(tdir, '*', '*', 'subagents', '*.jsonl'))
# 并行支 worktree 的流程目录是 <工作区>-<支名>/.flow/<批次>(实测 ShipLedger-P1-2-H2 的 ①写 与 -02A 的 ②A 都因此漏统计);
#   也认「工作区父目录/工作区名<任意后缀>/流程目录相对路径」这一形,别的项目的同名批次因父目录不同不会误入
ws = os.environ.get('FLOW_WS', '').rstrip('/')
lane_re = None
if ws and flowdir.startswith(ws + '/'):
    lane_re = re.compile(re.escape(os.path.dirname(ws)) + '/' + re.escape(os.path.basename(ws)) + r'[^/\s]*/' + re.escape(flowdir[len(ws) + 1:]) + r'(?![\w-])')
def belongs(txt):
    return flowdir in txt or (lane_re is not None and lane_re.search(txt) is not None)
rows = collections.defaultdict(lambda: dict(turns=0, inp=0, cw=0, cr=0, out=0, carried=0, eq=0.0, tools=0, dur=0.0, nread=0, npath=0,
                                            gen=0.0, tool=0.0, idle=0.0, stalls=[], model=collections.Counter(), n=0, sessions=[]))
parents = set(); matched = 0
def add(role, st):
    r = rows[role]
    for k in ('turns', 'inp', 'cw', 'cr', 'out', 'carried', 'eq', 'tools', 'dur', 'nread', 'npath', 'n', 'gen', 'tool', 'idle'): r[k] += st[k]
    r['stalls'] += st['stalls']; r['model'][st['model']] += 1; r['sessions'].append((st['sid'], st['turns']))
hits = []; sub_intervals = []
for f in files:
    if not belongs(first_user_text(f)): continue
    matched += 1
    st = stats(f)
    add(role_of(first_user_text(f)), st)
    hits.append(f); sub_intervals += st['intervals']
    parents.add(os.path.dirname(os.path.dirname(f)) + '.jsonl')

def span(path, needle=None):
    """文件里(含 needle 的)行的首末时间戳;needle=None = 全部行"""
    lo = hi = None
    with open(path, encoding='utf-8', errors='replace') as fh:
        for line in fh:
            if needle and needle not in line: continue
            try: o = json.loads(line)
            except Exception: continue
            if not o.get('timestamp'): continue
            try: t = ts(o['timestamp'])
            except Exception: continue
            lo = t if lo is None or t < lo else lo
            hi = t if hi is None or t > hi else hi
    return lo, hi

# 本批时间窗:先取 sub-agent 时段,再并上父会话里提到流程目录的那段(派单装配在第一个 agent 之前)
slo = shi = None
for f in hits:
    a, b = span(f)
    if a and (slo is None or a < slo): slo = a
    if b and (shi is None or b > shi): shi = b
winnote = ''; orch_cats = collections.Counter(); orch_solo = 0.0
def overlaps(a, b):
    return any(not (b < x or a > y) for x, y in sub_intervals)
for p in sorted(parents):
    if not os.path.isfile(p): continue
    a, b = span(p, flowdir)
    lo = min([x for x in (a, slo) if x], default=None)
    hi = max([x for x in (b, shi) if x], default=None)
    win = (lo, hi) if (a and b) else None      # 父会话零次提到流程目录 ⟹ 不切窗(切错比不切坏)
    if win: winnote = '(窗 ' + lo.astimezone().strftime('%m-%d %H:%M') + '–' + hi.astimezone().strftime('%H:%M') + ',父会话提到本流程目录的时段 ∪ sub-agent 时段)'
    else:   winnote = '(无窗:父会话零次提到本流程目录,跨批时数字偏大)'
    st = stats(p, win)
    add('编排方', st); orch_cats += st['cats']
    # 独占关键路径:编排方的请求区间与任何 sub-agent 活动区间不相交的那部分(它一个人在跑,别人都在等它)
    for a2, b2 in st['spans']:
        if not overlaps(a2, b2): orch_solo += (b2 - a2).total_seconds()
if matched == 0:
    print(f'FATAL: {tdir} 下扫了 {len(files)} 份 sub-agent transcript,没有一份的首条 user 消息含 {flowdir} —— 空集不算绿', file=sys.stderr); sys.exit(2)

def k(n):
    n = float(n)
    return f'{n/1e6:.2f}M' if n >= 1e6 else (f'{n/1e3:.1f}k' if n >= 1e3 else f'{int(n)}')
def hm(s):
    s = int(s); return f'{s//3600}h{(s%3600)//60:02d}m' if s >= 3600 else f'{s//60}m'
def rb(r): return r['npath'] / r['nread'] if r['nread'] else 0.0

head = ['| 项 | 时长 | token | 备注 |', '|---|---|---|---|']
lines = []; warns = []
wall = ['', '## 墙钟归因(生成 = 首块 − 上一事件 + 流式;工具 = 结果 − 末块;空等 = >15 min 无事件;卡顿 = 单次工具 ≥ %ds)' % STALL,
        '| 项 | 墙钟 | 生成 | 工具 | 空等 | 卡顿 |', '|---|---|---|---|---|---|']
total_turns = 0; total_sessions = 0
roles = [r for r in ORDER if r in rows] + sorted(set(rows) - set(ORDER))
for role in roles:
    r = rows[role]; cpt = r['tools'] / r['turns'] if r['turns'] else 0
    model = r['model'].most_common(1)[0][0]
    lines.append(f"| {role} | {hm(r['dur'])} | 携带 {k(r['carried'])} · 输出 {k(r['out'])} · 当量 {k(r['eq'])} | {r['turns']} 轮 · {cpt:.2f} 调用/轮 · 读批量 {rb(r):.2f} 路径/读调用({r['nread']} 次)· {model} · {r['n']} 会话{winnote if role == '编排方' else ''} |")
    solo = f" · 独占关键路径 {hm(orch_solo)}" if role == '编排方' else ''
    wall.append(f"| {role} | {hm(r['dur'])} | {hm(r['gen'])} | {hm(r['tool'])} | {hm(r['idle'])} | {len(r['stalls'])}{solo} |")
    total_turns += r['turns']; total_sessions += r['n']
    # 检验判据(只 WARN,不改 RC:轮数账是账不是门);请求上限按会话判,续轮单算
    for sid, tn in r['sessions']:
        if tn > TURN_CAP:
            warns.append(f"WARN {role}:会话 {sid} {tn} 请求 > FLOW_TURN_CAP {TURN_CAP} —— 携带 ∝ 轮数 × 上下文,而上下文又随轮数长(二次)。处置是拆任务,不是加纪律")
    if r['nread'] >= 5 and rb(r) < READ_BATCH_FLOOR:
        warns.append(f"WARN {role}:读批量 {rb(r):.2f} < {READ_BATCH_FLOOR} 路径/读调用 —— 多条读合进同一个 Bash;一次响应只发得出一个工具块,省不了「调用/轮」,只能省往返")
    for t0, d, desc in r['stalls']:
        warns.append(f"WARN 卡顿 {role}:{t0.astimezone().strftime('%m-%d %H:%M:%S')} 工具 {int(d)}s `{desc}` —— ≥ FLOW_STALL_SEC {STALL}s;输出若正常就是 harness 侧,不是脚本慢,从本批账上扣掉再比")
sub = [rows[x] for x in rows if x != '编排方']
srd = sum(x['nread'] for x in sub); spt = sum(x['npath'] for x in sub)
lines.append(f"| sub-agent 合计 | {hm(sum(x['dur'] for x in sub))} | 携带 {k(sum(x['carried'] for x in sub))} · 输出 {k(sum(x['out'] for x in sub))} · 当量 {k(sum(x['eq'] for x in sub))} | {sum(x['turns'] for x in sub)} 轮 · 读批量 {(spt / srd if srd else 0):.2f} 路径/读调用({srd} 次)· {sum(x['n'] for x in sub)} 会话(并行轴时长各自计) |")
outcat = []
if orch_cats:
    tot = sum(orch_cats.values()) or 1
    outcat = ['', '## 编排方输出去向(按输出 token;输出是墙钟的十倍杠杆,先砍这里)', '| 去向 | 输出 | 占比 |', '|---|---|---|']
    for kk, v in orch_cats.most_common(8): outcat.append(f'| {kk} | {k(v)} | {v * 100 // tot}% |')
out = '\n'.join(head + lines + wall + outcat + ([''] + warns if warns else []))
print(out)
if write == '--write':
    p = os.path.join(flowdir, '.usage.md')
    with open(p, 'w', encoding='utf-8') as fh:
        fh.write(f'# 轮数账(flow-usage 生成 {datetime.date.today().isoformat()};当量权重 input 1 · cache_creation 1.25 · cache_read 0.1 · output 5)\n\n{out}\n')
    print(f'写入 {p}')
print(f'USAGE OK: {total_sessions} 会话 / {total_turns} 轮')
