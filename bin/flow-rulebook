#!/bin/sh
# flow-rulebook —— 规则书(FLOW_LOCAL_DOC)的退役:把第 N 行逐字搬进同目录 <名>-archive.md 的一个新节,原文件删那一行。
# 病根:退役是每批 ≥1 次的机械动作(协议 §5 棘轮),p4e 实测编排方手做 3 个请求,其中一次自己 heredoc 里的 $(...) 把归档件污染了一回。
#   逐字归档 = 拿到的字节原样落盘,不经 shell 展开;这里用 python 搬,行内容不进任何 shell 字符串。
# 用法: flow-rulebook show                                              → 带行号打印规则书(退役前找行号用)
#       flow-rulebook retire <行号> --section "<§X · 批次>" --reason "<一句>"
#   归档件 = FLOW_LOCAL_DOC 去掉 .md 加 -archive.md(协议 §5:退役件逐字归档到工作区 .claude/flow-local-archive.md);不存在就建。
#   新节体例:`## <section> · 退役(<日期>)` + 「退役件(原 <文件> 第 N 行,逐字)」+ 那一行 + 「退役理由:<reason>」。
# 末行固定:`RULEBOOK OK: 第 N 行 → <归档件> §…;规则书 a → b 行`;行号越界 / 标题行 / 空行 ⟹ FATAL RC=2(标题与空行不是规矩,退它们是空转)。
#   棘轮读数(.rulebook-lines)不在这里动:flow-close 收口那一步量,只许降。
# 读的配置:FLOW_LOCAL_DOC_PATH
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

usage() { echo "用法: flow-rulebook show | retire <行号> --section \"<§X · 批次>\" --reason \"<一句>\"" >&2; exit 2; }
CMD="${1:-}"; [ -n "$CMD" ] || usage; shift
[ -f "$FLOW_LOCAL_DOC_PATH" ] || flow_die "规则书不存在: $FLOW_LOCAL_DOC_PATH(FLOW_LOCAL_DOC=$FLOW_LOCAL_DOC)"
ARCH="${FLOW_LOCAL_DOC_PATH%.md}-archive.md"

case "$CMD" in
  show)
    [ $# -eq 0 ] || usage
    awk '{printf "%4d  %s\n", NR, $0}' "$FLOW_LOCAL_DOC_PATH"
    echo "RULEBOOK OK: $(wc -l < "$FLOW_LOCAL_DOC_PATH" | tr -d ' ') 行;归档件 $ARCH"
    exit 0 ;;
  retire) ;;
  *) usage ;;
esac

N="${1:-}"; [ -n "$N" ] || usage; shift
case "$N" in ''|*[!0-9]*) flow_die "行号须为正整数: $N" ;; esac
SECTION=""; REASON=""
while [ $# -gt 0 ]; do
  case "$1" in --section|--reason) [ $# -ge 2 ] || flow_die "$1 缺值" ;; esac
  case "$1" in
    --section) SECTION="$2"; shift 2 ;;
    --reason) REASON="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$SECTION" ] && [ -n "$REASON" ] || flow_die "retire 必填:--section 与 --reason(退役理由是判断,不由脚本编)"

python3 - "$FLOW_LOCAL_DOC_PATH" "$ARCH" "$N" "$SECTION" "$REASON" <<'PY'
import sys, os, datetime
doc, arch, n, section, reason = sys.argv[1:6]
n = int(n)
lines = open(doc, encoding='utf-8').read().split('\n')
if lines and lines[-1] == '': lines.pop()          # 尾换行不算一行
total = len(lines)
if not (1 <= n <= total):
    print(f'FATAL: 行号 {n} 越界(规则书共 {total} 行;flow-rulebook show 看行号)', file=sys.stderr); sys.exit(2)
line = lines[n - 1]
if not line.strip():
    print(f'FATAL: 第 {n} 行是空行,不是规矩', file=sys.stderr); sys.exit(2)
if line.lstrip().startswith('#'):
    print(f'FATAL: 第 {n} 行是标题「{line.strip()[:40]}」,不是规矩(退标题会把整段孤儿化)', file=sys.stderr); sys.exit(2)
today = datetime.date.today().isoformat()
block = (f'\n## {section} · 退役({today})\n\n'
         f'**退役件(原 {os.path.basename(doc)} 第 {n} 行,逐字)**:\n\n{line}\n\n退役理由:{reason}\n')
old = open(arch, encoding='utf-8').read() if os.path.exists(arch) else f'# {os.path.basename(doc)} 退役件归档(逐字;由 flow-rulebook 追加)\n'
if not old.endswith('\n'): old += '\n'
tmp = arch + '.flow-rulebook.new'
open(tmp, 'w', encoding='utf-8').write(old + block); os.replace(tmp, arch)
del lines[n - 1]
tmp = doc + '.flow-rulebook.new'
open(tmp, 'w', encoding='utf-8').write('\n'.join(lines) + '\n'); os.replace(tmp, doc)
print(f'归档:{line[:80]}')
print(f'RULEBOOK OK: 第 {n} 行 → {arch} §「{section}」;规则书 {total} → {total - 1} 行')
PY
