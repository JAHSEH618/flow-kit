#!/bin/sh
# flow-doc-budget —— 中间文档防膨胀档。
# 病根:移交件把命令全量输出与上游正文直接抄进热路径 ⟹ 后续每一轮都为它付读取时间与 token(一个失控批次的流程目录能到正常批的 3 倍行数)。
# 主判据是**自写字节**,不是文件字节(0.5.0 改判,实测 p4c):
#   墙钟拟合 延迟(s) ≈ 1.5 + 1.4×(上下文/100k) + 1.3×(输出/100 token) —— 输出的杠杆是上下文的十倍;
#   而四条复审轴各有 21–34% 的墙钟花在 `cat >> 回件 <<EOF` 上(单次最慢 144 s / 7915 输出 token)。
#   贵的是「模型逐字打出来的字节」。派单件 48 KB 里 46 KB 是 flow-dispatch 生成的,一个字节也不用模型打,
#   却每批都要写一次 `budget-ok:` 把它带过 —— 同一条线同时判两种东西,于是对两种都判错。
#   ⟹ 生成段用 `<!-- flow:gen-begin -->` / `<!-- flow:gen-end -->` 括起(flow-dispatch 自动打),预算按总字节减去它来判。
# 三条结构规矩(§D)由本脚本机械执行其可数的那部分:
#   · 单件**自写** > FLOW_DOC_BUDGET_FILE 行 **或** > FLOW_DOC_BUDGET_SELF 字节,且首 5 行无 `budget-ok:<理由>` ⟹ RED(RC=1)
#     自写字节 > 红线的 90% ⟹ WARN(近线预警:实测两份 ④ 回件卡在 99%,作者是在压内容,不是在挪全量)
#     (字节线是主判据:token 按字节计,一份 112 KB 的复验件靠长行躲过了 400 行线;行数线只挡「行多」这一种胀法)
#   · 单件**总字节** > FLOW_DOC_BUDGET_BYTES ⟹ WARN(读取面还是它:一份派单件五个 agent 各读一遍)。总量线不 RED —— 生成段不是作者写的。
#   · 目录热路径合计 > FLOW_DOC_BUDGET_DIR 行 ⟹ WARN(件数问题多半是轮次问题,先看 §B-severity)
#   · `.evidence/` 子目录 = 旁证区,不设限不计入 —— 命令全量输出落这里,移交件贴摘录+路径。
#     (与 §J 硬规矩 1「探测器输出不许截断」是配套:全量都在,判读看旁证件,热路径不背它。)
# 标记不成对(begin 没有 end,或 end 多出来)⟹ WARN 并把 begin 之后整段算生成段:有人编辑进了生成块,要重跑 flow-dispatch。
# 另报两份规则书自身的体积(退役纪律的仪表盘):FLOW_LOCAL_DOC > FLOW_DOC_BUDGET_RULEBOOK 行 ⟹ WARN;FLOW_ROOT_DOC 只报 info。
# 空目录守卫(§J0):目录里零个 md ⟹ FATAL RC=2 —— 「没超预算」与「没扫到东西」不许长一个样。
#
# 用法: flow-doc-budget <流程目录>...        每件逐行给判定(贴 N 件 / 判 N 件),RC: 0 绿 / 1 有 RED / 2 FATAL
# 读的配置:FLOW_DOC_BUDGET_FILE FLOW_DOC_BUDGET_SELF FLOW_DOC_BUDGET_BYTES FLOW_DOC_BUDGET_DIR FLOW_DOC_BUDGET_RULEBOOK FLOW_LOCAL_DOC_PATH FLOW_ROOT_DOC_PATH
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

[ $# -ge 1 ] || { echo "用法: flow-doc-budget <流程目录>..." >&2; exit 2; }

red=0
for d in "$@"; do
  [ -d "$d" ] || { echo "FATAL: 目录不存在: $d" >&2; exit 2; }
  n=0; total=0; tbytes=0; stotal=0; sbytes_sum=0
  for f in "$d"/*.md; do          # 只扫顶层 md;.evidence/ 等子目录天然不进热路径
    [ -f "$f" ] || continue
    n=$((n+1))
    lines=$(wc -l < "$f" | tr -d ' ')
    bytes=$(wc -c < "$f" | tr -d ' ')
    # 生成段:<!-- flow:gen-begin --> … <!-- flow:gen-end -->(含标记行本身)。LC_ALL=C 让 length() 按字节数,别按字符数。
    # ⚠ 不许 `set -- $(awk …)`:那会把外层 `for d in "$@"` 的目录清单一起冲掉。四个数走参数展开切。
    g=$(LC_ALL=C awk '
      /<!-- *flow:gen-begin *-->/ { nb++; ing=1 }
      { if (ing) { gl++; gb += length($0) + 1 } }
      /<!-- *flow:gen-end *-->/   { if (ing) { ne++ }; ing=0 }
      END { printf "%d %d %d %d\n", gl+0, gb+0, nb+0, ne+0 }' "$f")
    genl=${g%% *}; g=${g#* }; genb=${g%% *}; g=${g#* }; nbegin=${g%% *}; nend=${g##* }
    [ "$genb" -le "$bytes" ] || genb=$bytes          # 无尾换行时 +1 会多算一字节,夹回去
    sl=$((lines - genl)); [ "$sl" -ge 0 ] || sl=0
    sb=$((bytes - genb)); [ "$sb" -ge 0 ] || sb=0
    total=$((total+lines)); tbytes=$((tbytes+bytes)); stotal=$((stotal+sl)); sbytes_sum=$((sbytes_sum+sb))
    [ "$nbegin" -eq "$nend" ] || echo "WARN flow:gen 标记不成对(begin $nbegin / end $nend):$f —— begin 之后整段按生成段计;有人编辑进了生成块就重跑 flow-dispatch"
    size="自写 $sl 行 $sb 字节(总 $lines 行 $bytes 字节)"
    over=""
    if [ "$sl" -gt "$FLOW_DOC_BUDGET_FILE" ]; then over="自写 $sl 行 > $FLOW_DOC_BUDGET_FILE"; fi
    if [ "$sb" -gt "$FLOW_DOC_BUDGET_SELF" ]; then over="${over:+$over;}自写 $sb 字节 > $FLOW_DOC_BUDGET_SELF"; fi
    if [ -n "$over" ]; then
      # ⚠ LC_ALL=C + -a:派单件的 plan 节选可能带非 UTF-8 字节,普通 grep 判成 binary 后静默不匹配(实测 p4c 01-dispatch.md)
      if head -5 "$f" | LC_ALL=C grep -qa 'budget-ok:'; then
        echo "WARN $size $f(budget-ok 显式带过:$(head -5 "$f" | LC_ALL=C sed -n 's/.*budget-ok:\(.*\)/\1/p' | head -1))"
      else
        echo "RED  $size $f($over;全量输出移 .evidence/ 贴摘录+路径,或首部加 budget-ok:<理由>)"
        red=1
      fi
    elif [ $((sb * 10)) -gt $((FLOW_DOC_BUDGET_SELF * 9)) ]; then
      echo "WARN $size $f(自写 > 字节线的 90%:贴线时作者会去压内容而不是把全量挪进 .evidence/ —— 先挪再写)"
    elif [ "$bytes" -gt "$FLOW_DOC_BUDGET_BYTES" ]; then
      echo "WARN $size $f(总字节 > $FLOW_DOC_BUDGET_BYTES:自写没超,读取面还是它 —— 五个 agent 每人读一遍)"
    else
      echo "ok   $size $f"
    fi
  done
  [ "$n" -gt 0 ] || { echo "FATAL: $d 里零个 md —— 「没超预算」与「没扫到」不许同型(§J0)" >&2; exit 2; }
  if [ "$total" -gt "$FLOW_DOC_BUDGET_DIR" ]; then
    echo "WARN 目录热路径合计 $total 行 > $FLOW_DOC_BUDGET_DIR:$d(件数多半是轮次问题 —— 先看 §B-severity 分级有没有执行)"
  fi
  echo "—— $d:$n 件 / 自写 $stotal 行 $sbytes_sum 字节 / 总 $total 行 $tbytes 字节(贴 $n 件 / 判 $n 件;.evidence/ 旁证区不计)"
done

for rb in "$FLOW_LOCAL_DOC_PATH" "$FLOW_ROOT_DOC_PATH"; do
  [ -f "$rb" ] || continue
  rl=$(wc -l < "$rb" | tr -d ' ')
  if [ "$rb" = "$FLOW_LOCAL_DOC_PATH" ] && [ "$rl" -gt "$FLOW_DOC_BUDGET_RULEBOOK" ]; then
    echo "WARN 规则书 $rl 行 > $FLOW_DOC_BUDGET_RULEBOOK:$rb —— 退役纪律该干活了(散文做成工具后降一行指针)"
  else
    echo "info 规则书 $rl 行:$rb"
  fi
done

exit $red
