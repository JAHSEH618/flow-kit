#!/bin/sh
# flow-review-diff —— 双模型对照:两份复审回件的丙栏(必闭)按文件锚分组对齐,给「原版独有 / 影子独有 / 共同文件」。
# 病根:审查轮是四轮制唯一的探测器,给某条轴换便宜模型只能用差集证明,不能拍脑袋;而 finding 是散文,逐字比没意义 ——
#   review-template 要求每条必闭带唯一锚(文件路径 / 文件:行),本脚本就按锚分组,等价与否留给人逐条判,机械部分只做枚举与计数。
# 用法: flow-review-diff <原版回件(绝对)> <影子回件(绝对)>
# 判读:原版独有为空 ⟹ 影子模型没漏掉原版抓到的文件,才许在 FLOW_ROLE_MODELS 里换;影子独有非空是加分不是免死。
# 末行固定:`REVIEW-DIFF: 原版独有 n 条 · 影子独有 m 条 · 共同文件 k`;任一回件没有 `## 丙栏` ⟹ FATAL RC=2。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config
A="${1:-}"; B="${2:-}"
[ -n "$A" ] && [ -n "$B" ] || flow_die "用法: flow-review-diff <原版回件(绝对)> <影子回件(绝对)>"
for p in "$A" "$B"; do case "$p" in /*) ;; *) flow_die "文件参数须绝对路径: $p" ;; esac; [ -f "$p" ] || flow_die "回件不存在: $p"; done

python3 - "$A" "$B" <<'PY'
import sys, re, collections
a, b = sys.argv[1:3]
ITEM = re.compile(r'^\s*(?:-|\*|\d+[.)])\s+')
ANCHOR = re.compile(r'[\w./-]+\.(?:ts|tsx|js|jsx|mjs|cjs|py|sh|md|sql|json|ya?ml|go|rs|java|kt|swift|css|html)(?::\d+)?')
def bing(path):
    items = []; on = False; found = False; cur = None
    for L in open(path, encoding='utf-8').read().split('\n'):
        if L.startswith('## '):
            if cur: items.append(cur); cur = None
            on = L.startswith('## 丙栏'); found = found or on; continue
        if not on: continue
        if ITEM.match(L):
            if cur: items.append(cur)
            cur = ITEM.sub('', L).strip()
        elif cur is not None and L.strip():
            cur += ' ' + L.strip()
    if cur: items.append(cur)
    if not found:
        print(f'FATAL: {path} 里没有 `## 丙栏` 节 —— 不是 review-template 的回件,拒绝比对', file=sys.stderr); sys.exit(2)
    return items
def group(items):
    g = collections.defaultdict(list)
    for it in items:
        files = sorted(set(re.sub(r':\d+$', '', m) for m in ANCHOR.findall(it))) or ['(无文件锚)']
        for f in files: g[f].append(it)
    return g
ga, gb = group(bing(a)), group(bing(b))
only_a = {f: v for f, v in ga.items() if f not in gb}
only_b = {f: v for f, v in gb.items() if f not in ga}
both = sorted(set(ga) & set(gb))
print(f'## 原版独有(文件在原版丙栏、不在影子丙栏;{sum(len(v) for v in only_a.values())} 条)')
for f in sorted(only_a):
    for it in only_a[f]: print(f'- {f}: {it[:200]}')
print(f'\n## 影子独有({sum(len(v) for v in only_b.values())} 条)')
for f in sorted(only_b):
    for it in only_b[f]: print(f'- {f}: {it[:200]}')
print(f'\n## 共同文件({len(both)};逐条人判是否同一发现)')
for f in both:
    print(f'- {f}')
    for it in ga[f]: print(f'    原版: {it[:200]}')
    for it in gb[f]: print(f'    影子: {it[:200]}')
print(f"\nREVIEW-DIFF: 原版独有 {sum(len(v) for v in only_a.values())} 条 · 影子独有 {sum(len(v) for v in only_b.values())} 条 · 共同文件 {len(both)}")
PY
