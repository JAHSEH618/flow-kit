#!/bin/sh
# flow-trace —— REQ ↔ 测试对账(「验收判据有没有测试背书」的探测器;0.3 起替代 flow-receipts)。
# 病根:892 个测试里只有 69 个引到 spec 节,接收位靠人眼对;「已覆盖」是一句声明,不是一次核对。
#   本脚本把对账做成字面匹配:plan 任务节里的 REQ-ID(带状态)vs 测试标题里的 `[REQ-ID]`,不做模糊。
#
# 用法: flow-trace <plan文件(仓相对或绝对)> <任务号>
#   例: flow-trace specs/plan/p4-api-spa.md P4-T2
# 读的是:任务节 `## <任务号>` 内每一行 `REQ-<任务>-NN [open|done|deferred …]`(格式见协议 §账本与 spec)。
# 测试文件 = git 看得见的 *.test.ts(x) / *.spec.ts(x),含未跟踪(测试先行:新测试在提交前就该算数)。
# 判定:
#   · open / done 的 REQ 零测试 ⟹ RED(RC=1)
#   · deferred 的 REQ 不计(它已转成欠账,由账本管)
#   · 节里出现却没有状态行的 REQ ⟹ RED(状态不可见 = 对账盲区)
#   · 测试里引了、任何 spec md 里都找不到的 REQ ⟹ WARN(孤儿测试:spec 删了行或标题写错号)
#   · 任务节零条 REQ ⟹ FATAL(RC=2):「全覆盖」与「没扫到」不许同型
#   · 零个测试文件 ⟹ FATAL(RC=2)
# 末行固定:`TRACE OK: …` / `TRACE RED: …`。判据纪律:grep 的 RC 与命令同层,不进 && 链;计数用 LC_ALL=C。
# 读的配置:FLOW_REPO_DIR FLOW_SPEC_DIRS
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

[ $# -ge 2 ] || { echo "用法: flow-trace <plan文件> <任务号,如 P4-T2>" >&2; exit 2; }
f="$1"; t="$2"
cd "$FLOW_REPO_DIR"
[ -f "$f" ] || flow_die "文件不存在 $f"

tmp="$(flow_tmpdir)/.flow-trace-$$"; mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

sec_start=$(grep -n "^## $t " "$f" | head -1 | cut -d: -f1)
[ -n "$sec_start" ] || sec_start=$(grep -n "^## $t" "$f" | head -1 | cut -d: -f1)
[ -n "$sec_start" ] || flow_die "找不到节 ## $t"
sec_end=$(awk -v s="$sec_start" 'NR>s && /^## /{print NR-1; exit}' "$f")
[ -n "$sec_end" ] || sec_end=$(wc -l < "$f" | tr -d ' ')
sed -n "${sec_start},${sec_end}p" "$f" > "$tmp/sec"

# 定义行 = 同一行既有 REQ-ID 又有 [状态];只提到 ID 没有状态的行单独记,后面判 RED
LC_ALL=C grep -E 'REQ-[A-Z0-9]+-[0-9]+' "$tmp/sec" > "$tmp/mentions"
: > "$tmp/defs"
while IFS= read -r L; do
  id=$(printf '%s' "$L" | LC_ALL=C grep -oE 'REQ-[A-Z0-9]+-[0-9]+' | head -1)
  st=$(printf '%s' "$L" | LC_ALL=C grep -oE '\[(open|done|deferred[^]]*)\]' | head -1 | tr -d '[]')
  [ -n "$st" ] && printf '%s\t%s\n' "$id" "$st" >> "$tmp/defs"
done < "$tmp/mentions"
sort -u -o "$tmp/defs" "$tmp/defs"
LC_ALL=C grep -oE 'REQ-[A-Z0-9]+-[0-9]+' "$tmp/mentions" | sort -u > "$tmp/allids"
nreq=$(LC_ALL=C grep -c . "$tmp/allids")
if [ "$nreq" -eq 0 ]; then
  echo "FATAL: 节 ## $t 里零条 REQ 行 —— 「全覆盖」与「没扫到」不许同型;先把验收写成 REQ-ID [open] 一句一行" >&2
  exit 2
fi

# 测试文件:已跟踪 + 未跟踪(测试先行的新文件),遵守 .gitignore(dist / node_modules 天然不进)
git -c core.quotepath=false ls-files --cached --others --exclude-standard -- '*.test.ts' '*.test.tsx' '*.spec.ts' '*.spec.tsx' > "$tmp/tests"
rc=$?
[ "$rc" -eq 0 ] || flow_die "枚举测试文件失败(git ls-files RC=$rc),拒绝给结论"
[ -s "$tmp/tests" ] || flow_die "仓里零个测试文件 —— 「全覆盖」与「没扫到」不许同型"
ntests=$(LC_ALL=C grep -c . "$tmp/tests")

red=0; covered=0; deferred=0; missing=0
while IFS="$(printf '\t')" read -r id st; do
  [ -n "$id" ] || continue
  case "$st" in
    deferred*)
      deferred=$((deferred+1))
      echo "info $id [$st] 不计(已转欠账,由账本管)"
      continue ;;
  esac
  tr '\n' '\0' < "$tmp/tests" | LC_ALL=C xargs -0 grep -nF -- "[$id]" > "$tmp/hits" 2>/dev/null   # ⚠ LC_ALL 放 xargs 前:放 grep 前会被 xargs 当成命令名,静默空集
  n=$(LC_ALL=C grep -c . "$tmp/hits")
  if [ "$n" -gt 0 ]; then
    covered=$((covered+1))
    echo "ok   $id [$st] $n 处:$(cut -d: -f1,2 "$tmp/hits" | head -3 | tr '\n' ' ')"
  else
    missing=$((missing+1)); red=1
    echo "RED  $id [$st] 0 处 —— 测试标题里没有 [$id](测试先行:先写红过的测试,再实现)"
  fi
done < "$tmp/defs"

# 提到了却没有状态行的 REQ
cut -f1 "$tmp/defs" > "$tmp/defids"
nostatus=$(LC_ALL=C grep -vxF -f "$tmp/defids" "$tmp/allids" || true)
if [ -n "$nostatus" ]; then
  for id in $nostatus; do echo "RED  $id 在节里出现但没有 [open|done|deferred] 状态行(状态不可见 = 对账盲区)"; done
  red=1
fi

# 孤儿:测试引了、任何 spec md 都没有的 REQ
tr '\n' '\0' < "$tmp/tests" | LC_ALL=C xargs -0 grep -ohE '\[REQ-[A-Z0-9]+-[0-9]+\]' 2>/dev/null | tr -d '[]' | sort -u > "$tmp/cited"
orphans=0
while IFS= read -r id; do
  [ -n "$id" ] || continue
  found=0
  for d in $FLOW_SPEC_DIRS; do
    [ -d "$d" ] || continue
    if LC_ALL=C grep -rqF --include='*.md' -- "$id" "$d"; then found=1; break; fi
  done
  [ "$found" = 1 ] || { orphans=$((orphans+1)); echo "WARN $id 被测试引用,但 $FLOW_SPEC_DIRS 下任何 md 都没有它(spec 删了行,或标题写错号)"; }
done < "$tmp/cited"

nostat_n=$(printf '%s\n' "$nostatus" | LC_ALL=C grep -c .)
judged=$((covered+missing+deferred+nostat_n))
if [ "$red" = 1 ]; then
  echo "TRACE RED: $covered/$((covered+missing)) 条 open/done REQ 有测试;缺 $missing;deferred $deferred 不计;孤儿 $orphans WARN(REQ $nreq 条 / 判 $judged 条;测试文件 $ntests)"
  exit 1
fi
echo "TRACE OK: $covered/$covered 条 open/done REQ 有测试;deferred $deferred 不计;孤儿 $orphans WARN(REQ $nreq 条 / 判 $judged 条;测试文件 $ntests)"
exit 0
