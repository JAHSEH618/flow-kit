#!/usr/bin/env bash
# flow-manifest —— 冻结清单机械枚举与核对(「实改集 ⊄ 申报」的探测器)。
# 根因:git status 看不见 gitignore 区(规格目录可能刻意只活本机),靠它枚举必漏。
# 枚举走两条轴:git(tracked + 未跟踪)+ 基线 shasum 扫描(ignored 区,只在 FLOW_SPEC_UNTRACKED=1 时开)。
# 仓根取自 FLOW_REPO_DIR(脚本自己 cd,不依赖调用方 cwd);默认扫描区取自 FLOW_SPEC_DIRS。
#
# 用法:
#   flow-manifest baseline <基线输出文件(绝对路径)> [扫描区(仓相对)...]   # 批次开工时打基线
#   flow-manifest verify   <基线文件(绝对路径)> <申报清单文件(绝对路径)>   # 收工核对:实改集 ⊄ 申报 → RED,exit 1
# 申报清单:shasum 格式(hash  路径)/ `git XY 路径` / 纯路径行都认;行尾 ` # 说明` 会剥掉。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

# ⚠ 这个探测器自己会假绿,而它正是「实改集 ⊄ 申报」的唯一探测器 —— 探测器假绿比没有探测器更坏
# (没有时人知道自己没有,假绿时人以为自己有)。两个成因都按**根因**修,不靠加守卫盖:
#   ① 不用 bash 进程替换 `<(...)`:`sh` 跑时 syntax error,而 `set -u` 不含 `-e` ⟹ 报错**不中止**,末尾 verify OK 照打。
#      已改用临时文件。(用 `[ -z "$BASH_VERSION" ]` 挡不住:macOS 的 `sh` 就是 bash 的 POSIX 模式,别再走这条路。)
#   ② 不在 git 仓里跑时 `git status` 报 fatal 但脚本照跑,给出「git 0 + ignored 0 全绿」的**空集假绿**。已加仓库守卫。
cd "$FLOW_REPO_DIR"
git rev-parse --git-dir >/dev/null 2>&1 || flow_die "FLOW_REPO_DIR 不是 git 仓库(轴1 靠 git status 枚举实改集): $FLOW_REPO_DIR"

cmd="${1:-}"
[ -n "$cmd" ] || { echo "用法: flow-manifest baseline|verify ..." >&2; exit 2; }

# 扫描区逐文件出 `hash  path`(哈希只经 flow_sha256;find -exec 调不了 sh 函数,故用 while)
sha_scan() {
  for a in "$@"; do
    [ -d "$a" ] || continue
    find "$a" -type f | while IFS= read -r f; do flow_sha256 "$f"; done
  done
}

case "$cmd" in
baseline)
  out="${2:-}"; [ -n "$out" ] || flow_die "baseline 需要输出文件路径(绝对路径)"
  case "$out" in /*) ;; *) flow_die "基线输出文件必须绝对路径(脚本会 cd 到仓根): $out" ;; esac
  shift 2
  areas="${*:-$FLOW_SPEC_DIRS}"
  {
    # 头行记下扫描区:verify 按它复扫,两侧同源(嵌套目录不能靠 cut -d/ 猜回来)
    echo "# freeze-baseline $(date +%FT%T) @ $(git rev-parse --short HEAD 2>/dev/null || echo none) areas: $areas"
    # -uall:不带它 git 把未跟踪**目录**折成一行目录名,整目录的新文件从此不在基线里
    # (实测:未申报文件藏进未跟踪目录,verify 照绿)
    git status --porcelain -uall | sed 's/^/git /'
    if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then sha_scan $areas | sed 's/^/sha /'; fi
  } > "$out"
  if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then
    n=$(grep -c '^sha ' "$out" || true)
    echo "baseline → $out (ignored 区 $n 个文件入基线;扫描区: $areas)"
  else
    [ $# -gt 0 ] && flow_warn "扫描区参数被忽略(FLOW_SPEC_UNTRACKED=0): $*"
    echo "baseline → $out (shasum 轴关闭:FLOW_SPEC_UNTRACKED=0,只走 git 轴)"
  fi
  ;;

verify)
  base="${2:-}"; declared="${3:-}"
  [ -n "$base" ] || flow_die "verify 需要基线文件(绝对路径)"
  [ -n "$declared" ] || flow_die "verify 需要申报清单文件(绝对路径)"
  case "$base" in /*) ;; *) flow_die "基线文件必须绝对路径(脚本会 cd 到仓根): $base" ;; esac
  case "$declared" in /*) ;; *) flow_die "申报清单必须绝对路径(脚本会 cd 到仓根): $declared" ;; esac
  [ -f "$base" ] || flow_die "基线不存在 $base"
  [ -f "$declared" ] || flow_die "申报清单不存在 $declared"

  # 轴1 tracked:当前 git status(与基线时点的 status 无关,收工态即实改集)
  # ⚠ ① `-uall`:不带它未跟踪目录折成一行目录名,**藏在里面的未申报文件 verify 照绿**,
  #      而 verify 正是「实改集 ⊄ 申报」这条的唯一探测器,它自己有盲区就等于没有探测器。
  #   ② 剥状态位改用固定 3 字符前缀 + 显式处理 rename 的 ` -> `;原 `awk '{print $NF}'` 对含空格的路径会截断。
  tracked=$(git status --porcelain -uall | sed 's/^...//' | sed 's/.* -> //')

  # 轴2 ignored 区:当前 shasum vs 基线 —— 新增/改动(基线里没有这行)与删除(现况里没有)分列
  # 基线与配置要同源:基线里有 sha 行而本次配置关了 shasum 轴 ⟹ 轴2 会被静默丢掉,拒绝给结论
  if [ "$FLOW_SPEC_UNTRACKED" != 1 ] && grep -q '^sha ' "$base"; then
    flow_die "基线含 sha 行但 FLOW_SPEC_UNTRACKED=0:基线与配置不同源,拒绝给出红/绿结论"
  fi
  ig_changed=""; ig_gone=""
  if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then
    areas=$(sed -n '1s/^# freeze-baseline .* areas: //p' "$base")
    [ -n "$areas" ] || areas=$(sed -n 's|^sha [0-9a-f]*  ||p' "$base" | cut -d/ -f1 | sort -u)   # 旧格式基线兜底
    cur=$(sha_scan $areas)
    basesha=$(sed -n 's/^sha //p' "$base" | sort)
    cursha=$(printf '%s\n' "$cur" | sort)

    # 空集守卫:基线里明明有 sha 行,却一条都没解析出来 = 格式变了或 sed 没匹配上。
    # 不加这条的话,`comm` 拿两个空集比出空差集,末尾照样打 verify OK —— 又一个假绿。
    if grep -q '^sha ' "$base" && [ -z "$basesha" ]; then
      flow_die "基线里有 'sha ' 行但一条都没解析出来,格式对不上,拒绝给出绿灯。"
    fi

    # 临时文件替代进程替换(见文件头 ①):POSIX sh 也能跑,不再可能 syntax error 后假绿。
    td=$(flow_tmpdir)
    tb=$(mktemp "$td/flow-manifest.XXXXXX"); tc=$(mktemp "$td/flow-manifest.XXXXXX")
    tbp=$(mktemp "$td/flow-manifest.XXXXXX"); tcp=$(mktemp "$td/flow-manifest.XXXXXX")
    trap 'rm -f "$tb" "$tc" "$tbp" "$tcp"' EXIT
    printf '%s\n' "$basesha" > "$tb"
    printf '%s\n' "$cursha"  > "$tc"
    sed 's/^[0-9a-f]*  //' "$tb" | sort -u > "$tbp"
    sed 's/^[0-9a-f]*  //' "$tc" | sort -u > "$tcp"
    ig_changed=$(comm -13 "$tb" "$tc" | sed 's/^[0-9a-f]*  //')
    ig_gone=$(comm -23 "$tbp" "$tcp")
  else
    echo "shasum 轴关闭:FLOW_SPEC_UNTRACKED=0,只走 git 轴"
  fi

  # 申报清单归一成纯路径行,再做**整行定长**比对。
  # ⚠ 原写法 `grep -q "$p\$"` 把路径当**正则**用 —— `.` 匹配任意字符、`+`/`(` 会炸,
  #   于是 `a/b.ts` 能被 `a/bXts` 满足:**松匹配 = 假绿**,而这里的假绿方向恰好是「漏申报被放过」。
  #   `grep -qxF` = 整行 + 固定串,两个方向都收紧。
  #   三种申报行都认:`<hash>  path`(shasum 格式)/ `git XY path` / 裸 `path`。
  #   ⚠ 申报清单是**人写的**,行尾常带 `路径␣␣# 说明`。归一不剥行尾注释时,`grep -qxF` 对**每一行**都不相等
  #   ⟹ 全红。这是**假红**,而假红与「真的全部漏申报」输出**逐字相同**,人只能靠猜区分 —— 探测器一旦
  #   开始说狼来了,下一次真的漏申报就会被耸肩略过。故:① 剥行尾 `␣+#...`;
  #   ② 剥完仍含空白的行 **FATAL**(路径不许含空白,那种行必是格式错,不许当路径静默不匹配)。
  declared_paths=$(sed -e 's/^[0-9a-f]\{40,\}  //' -e 's/^git \(..\) //' -e 's/^git //' "$declared" \
                   | sed 's/.* -> //' | sed 's/^[[:space:]]*//' | grep -v '^#' \
                   | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//' \
                   | grep . | sort -u)

  if printf '%s\n' "$declared_paths" | grep -q '[[:space:]]'; then
    echo "FATAL: 申报清单归一后仍有含空白的行,判为格式错(路径不许含空白),拒绝给出红/绿结论:" >&2
    printf '%s\n' "$declared_paths" | grep '[[:space:]]' | sed 's/^/  /' >&2
    exit 2
  fi

  red=0
  for p in $tracked $ig_changed; do
    printf '%s\n' "$declared_paths" | grep -qxF -- "$p" || { echo "RED 漏申报: $p"; red=1; }
  done
  for p in $ig_gone; do
    printf '%s\n' "$declared_paths" | grep -qxF -- "$p" || { echo "RED 漏申报(被删): $p"; red=1; }
  done
  if [ "$red" = 0 ]; then
    echo "verify OK: 实改集(git $(printf '%s\n' $tracked | grep -c . || true) + ignored $(printf '%s\n' $ig_changed | grep -c . || true)) 全部在申报清单内"
  fi
  exit $red
  ;;

*) flow_die "未知子命令: $cmd(只认 baseline|verify)" ;;
esac
