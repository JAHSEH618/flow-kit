#!/usr/bin/env bash
# flow-manifest —— 冻结清单机械枚举与核对(「实改集 ⊄ 申报」的探测器)。
# 根因:git status 看不见 gitignore 区(规格目录可能刻意只活本机),靠它枚举必漏。
# 枚举走两条轴:git(tracked + 未跟踪)+ 基线 shasum 扫描(ignored 区,只在 FLOW_SPEC_UNTRACKED=1 时开)。
# 仓根取自 FLOW_REPO_DIR(脚本自己 cd,不依赖调用方 cwd);默认扫描区取自 FLOW_SPEC_DIRS。
# 0.9.0 两条新判据,都记在基线里、verify 时核:
#   · 树身份:基线头记 `root: <git rev-parse --show-toplevel>`,verify 的树 root 不同 ⟹ FATAL(两侧不同源,§J 硬规矩 4)。
#     病根:FLOW_SPEC_UNTRACKED=0 时 git 轴根本不读基线(见 verify 注释),主树与 worktree / rsync 快照同 HEAD 就同基线,
#     verify 量哪棵树全凭 cwd 找到的 config —— P3-4 四条 A 轴在副本里跑 verify 报 git 12,读数与主树同型,没人分得出。
#     快照 / 副本里**不该跑 verify**:它判的是活树,归编排方 flow-round close;证副本没被动用 shasum -c <上一轮 .after>。
#   · 测试锁:基线逐件记 FLOW_TEST_GLOBS 命中件的哈希(`test <hash>  <path>`);verify 时已有测试件哈希变了 / 被删,
#     而申报行尾没有 `# 裁决-N` ⟹ RED;本轮改过或新增的测试件含 FLOW_TEST_SKIP_RE(.only / .skip / xit …)⟹ 同样 RED。
#     病根:测试文件在写轮的写权限面内,削断言 / 跳过 / 改期望值一个字都没人看(flow-trace 只判「REQ 有没有测试」);
#     2026 年的 reward-hacking 实证(SpecBench / BAITBENCH)一致:靠 prompt 说「别改测试」>50% 照改,锁住才归零。
#     例外走裁决:申报行写成 `path  # 裁决-N 为什么改` —— 与 flow-close 的越面例外同一条通道。
#
# 用法:
#   flow-manifest baseline <基线输出文件(绝对路径)> [扫描区(仓相对)...]   # 批次开工时打基线
#   flow-manifest verify   <基线文件(绝对路径)> <申报清单文件(绝对路径)>   # 收工核对:实改集 ⊄ 申报 → RED,exit 1
# 申报清单:shasum 格式(hash  路径)/ `git XY 路径` / 纯路径行都认;行尾 ` # 说明` 会剥掉。
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

# ⚠ 这个探测器自己会假绿,而它正是「实改集 ⊄ 申报」的唯一探测器 —— 探测器假绿比没有探测器更坏
# (没有时人知道自己没有,假绿时人以为自己有)。两个成因都按**根因**修,不靠加守卫盖:
#   ① 不用 bash 进程替换 `<(...)`:`sh` 跑时 syntax error,而 `set -u` 不含 `-e` ⟹ 报错**不中止**,末尾 verify OK 照打。
#      已改用临时文件。(用 `[ -z "$BASH_VERSION" ]` 挡不住:macOS 的 `sh` 就是 bash 的 POSIX 模式,别再走这条路。)
#   ② 不在 git 仓里跑时 `git status` 报 fatal 但脚本照跑,给出「git 0 + ignored 0 全绿」的**空集假绿**。已加仓库守卫。
#   ③ kit 自有件过滤器曾用 `awk -v pats=<多行串>`:BSD awk 报 newline in string 后**吐空集**⟹ git 轴恒空恒绿
#      (实测:申报 1 件、实改 15 件照 OK)。根因改在 lib(ENVIRON 传值);这里补 RC 同层捕获,枚举失败不许当空集。
#      中文路径被 core.quotepath 转成八进制转义、申报行永远对不上,也一并在 lib 的 flow_changed_paths 里关掉。
cd "$FLOW_REPO_DIR"
git rev-parse --git-dir >/dev/null 2>&1 || flow_die "FLOW_REPO_DIR 不是 git 仓库(轴1 靠 git status 枚举实改集): $FLOW_REPO_DIR"

cmd="${1:-}"
[ -n "$cmd" ] || { echo "用法: flow-manifest baseline|verify ..." >&2; exit 2; }

# 测试件枚举(与 flow-trace 同源:git 看得见的 FLOW_TEST_GLOBS 命中件,含未跟踪;set -f 防 shell 先把 glob 展开成仓根的文件名)
test_files() {
  set -f; set -- ; for g in $FLOW_TEST_GLOBS; do set -- "$@" "$g"; done; set +f
  [ $# -gt 0 ] || return 0
  git -c core.quotepath=false ls-files --cached --others --exclude-standard -- "$@" | sort -u
}
# 扫描区逐文件出 `hash  path`(哈希只经 flow_sha256;find -exec 调不了 sh 函数,故用 while)
sha_scan() {
  for a in "$@"; do
    [ -d "$a" ] || continue
    find "$a" -type f | while IFS= read -r f; do flow_sha256 "$f"; done
  done
}

case "$cmd" in
baseline)
  out="${2:-}"; [ -n "$out" ] || flow_die "baseline 需要输出文件路径(绝对路径)"
  case "$out" in /*) ;; *) flow_die "基线输出文件必须绝对路径(脚本会 cd 到仓根): $out" ;; esac
  shift 2
  areas="${*:-$FLOW_SPEC_DIRS}"
  tlb=$(mktemp "$(flow_tmpdir)/flow-manifest.XXXXXX")
  {
    # 头行记下扫描区:verify 按它复扫,两侧同源(嵌套目录不能靠 cut -d/ 猜回来)
    echo "# freeze-baseline $(date +%FT%T) @ $(git rev-parse --short HEAD 2>/dev/null || echo none) root: $(git rev-parse --show-toplevel) areas: $areas"
    # F-14:这份文件与 `.after-*-hashes.txt` 肉眼极像、消费者不同(行首 git/sha 前缀)—— 喂给 shasum -c 恒空转恒绿。头行第二句写死消费者。
    echo "# ⚠ 只能喂 flow-manifest verify;不是 shasum -c 体例(行首带 git/sha 前缀),喂给 shasum -c 一行都对不上 = 恒绿"
    # -uall:不带它 git 把未跟踪**目录**折成一行目录名,整目录的新文件从此不在基线里
    # (实测:未申报文件藏进未跟踪目录,verify 照绿)
    git -c core.quotepath=false status --porcelain -uall | sed 's/^/git /'   # 关 quotepath:中文路径否则成八进制转义
    # 测试锁(0.9.0):已有测试件逐个记哈希;基线时点已删的(索引里有、树上没有)不记 —— 它不是本轮删的
    test_files | while IFS= read -r f; do [ -f "$f" ] && flow_sha256 "$f"; done | sed 's/^/test /' > "$tlb"
    echo "# test-lock $(grep -c . "$tlb" || true)"   # 零件与「旧基线没这一轴」要分得开(§J0)
    cat "$tlb"
    if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then sha_scan $areas | sed 's/^/sha /'; fi
  } > "$out"
  rm -f "$tlb"
  nt=$(grep -c '^test ' "$out" || true)
  if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then
    n=$(grep -c '^sha ' "$out" || true)
    echo "baseline → $out (ignored 区 $n 个文件入基线;扫描区: $areas;测试锁 $nt 件;root $(git rev-parse --show-toplevel))"
  else
    [ $# -gt 0 ] && flow_warn "扫描区参数被忽略(FLOW_SPEC_UNTRACKED=0): $*"
    echo "baseline → $out (shasum 轴关闭:FLOW_SPEC_UNTRACKED=0,只走 git 轴;测试锁 $nt 件;root $(git rev-parse --show-toplevel))"
  fi
  ;;

verify)
  base="${2:-}"; declared="${3:-}"
  [ -n "$base" ] || flow_die "verify 需要基线文件(绝对路径)"
  [ -n "$declared" ] || flow_die "verify 需要申报清单文件(绝对路径)"
  case "$base" in /*) ;; *) flow_die "基线文件必须绝对路径(脚本会 cd 到仓根): $base" ;; esac
  case "$declared" in /*) ;; *) flow_die "申报清单必须绝对路径(脚本会 cd 到仓根): $declared" ;; esac
  [ -f "$base" ] || flow_die "基线不存在 $base"
  [ -f "$declared" ] || flow_die "申报清单不存在 $declared"

  # 轴0 树身份(0.9.0):基线打在哪棵树就只许在哪棵树 verify。两侧都走 git 取物理路径(/tmp 与 /private/tmp 之类的假不等由 git 归一)
  broot=$(sed -n '1s/^# freeze-baseline .* root: \(.*\) areas: .*$/\1/p' "$base")
  here=$(git rev-parse --show-toplevel)
  if [ -z "$broot" ]; then
    echo "树身份:基线无 root 行(0.9.0 前打的),本次未核"
  elif [ "$broot" != "$here" ]; then
    flow_die "基线打在 $broot,本次 verify 量的是 $here —— 两侧不同源,拒绝给出红/绿结论。verify 判的是活树,归编排方在活树跑(flow-round close);快照 / worktree 副本里要证「没被动」,跑 shasum -a 256 -c <上一轮 .after-*-hashes.txt>"
  fi

  # 轴1 tracked:当前 git status(与基线时点的 status 无关,收工态即实改集)。枚举只经 flow_changed_paths
  #   (-uall / 剥状态位 / quotepath / kit 自有件过滤(契约 8)都在 lib 里,三条命令同源;为什么见 lib 注释)。
  #   RC 同层捕获(文件头 ③):枚举失败吐的是空集,而空集在这里就是绿 —— 不许静默。
  tracked=$(flow_changed_paths) || flow_die "实改集枚举失败(flow_changed_paths RC≠0),拒绝给出红/绿结论"

  # 轴2 ignored 区:当前 shasum vs 基线 —— 新增/改动(基线里没有这行)与删除(现况里没有)分列
  # 基线与配置要同源:基线里有 sha 行而本次配置关了 shasum 轴 ⟹ 轴2 会被静默丢掉,拒绝给结论
  if [ "$FLOW_SPEC_UNTRACKED" != 1 ] && grep -q '^sha ' "$base"; then
    flow_die "基线含 sha 行但 FLOW_SPEC_UNTRACKED=0:基线与配置不同源,拒绝给出红/绿结论"
  fi
  ig_changed=""; ig_gone=""
  if [ "$FLOW_SPEC_UNTRACKED" = 1 ]; then
    areas=$(sed -n '1s/^# freeze-baseline .* areas: //p' "$base")
    [ -n "$areas" ] || areas=$(sed -n 's|^sha [0-9a-f]*  ||p' "$base" | cut -d/ -f1 | sort -u)   # 旧格式基线兜底
    cur=$(sha_scan $areas)
    basesha=$(sed -n 's/^sha //p' "$base" | sort)
    cursha=$(printf '%s\n' "$cur" | sort)

    # 空集守卫:基线里明明有 sha 行,却一条都没解析出来 = 格式变了或 sed 没匹配上。
    # 不加这条的话,`comm` 拿两个空集比出空差集,末尾照样打 verify OK —— 又一个假绿。
    if grep -q '^sha ' "$base" && [ -z "$basesha" ]; then
      flow_die "基线里有 'sha ' 行但一条都没解析出来,格式对不上,拒绝给出绿灯。"
    fi

    # 临时文件替代进程替换(见文件头 ①):POSIX sh 也能跑,不再可能 syntax error 后假绿。
    td=$(flow_tmpdir)
    tb=$(mktemp "$td/flow-manifest.XXXXXX"); tc=$(mktemp "$td/flow-manifest.XXXXXX")
    tbp=$(mktemp "$td/flow-manifest.XXXXXX"); tcp=$(mktemp "$td/flow-manifest.XXXXXX")
    trap 'rm -f "$tb" "$tc" "$tbp" "$tcp"' EXIT
    printf '%s\n' "$basesha" > "$tb"
    printf '%s\n' "$cursha"  > "$tc"
    sed 's/^[0-9a-f]*  //' "$tb" | sort -u > "$tbp"
    sed 's/^[0-9a-f]*  //' "$tc" | sort -u > "$tcp"
    ig_changed=$(comm -13 "$tb" "$tc" | sed 's/^[0-9a-f]*  //')
    ig_gone=$(comm -23 "$tbp" "$tcp")
  else
    echo "shasum 轴关闭:FLOW_SPEC_UNTRACKED=0,只走 git 轴"
  fi

  # 申报清单归一成纯路径行,再做**整行定长**比对。
  # ⚠ 原写法 `grep -q "$p\$"` 把路径当**正则**用 —— `.` 匹配任意字符、`+`/`(` 会炸,
  #   于是 `a/b.ts` 能被 `a/bXts` 满足:**松匹配 = 假绿**,而这里的假绿方向恰好是「漏申报被放过」。
  #   `grep -qxF` = 整行 + 固定串,两个方向都收紧。
  #   三种申报行都认:`<hash>  path`(shasum 格式)/ `git XY path` / 裸 `path`。
  #   ⚠ 申报清单是**人写的**,行尾常带 `路径␣␣# 说明`。归一不剥行尾注释时,`grep -qxF` 对**每一行**都不相等
  #   ⟹ 全红。这是**假红**,而假红与「真的全部漏申报」输出**逐字相同**,人只能靠猜区分 —— 探测器一旦
  #   开始说狼来了,下一次真的漏申报就会被耸肩略过。故:① 剥行尾 `␣+#...`;
  #   ② 剥完仍含空白的行 **FATAL**(路径不许含空白,那种行必是格式错,不许当路径静默不匹配)。
  declared_paths=$(sed -e 's/^[0-9a-f]\{40,\}  //' -e 's/^git \(..\) //' -e 's/^git //' "$declared" \
                   | sed 's/.* -> //' | sed 's/^[[:space:]]*//' | grep -v '^#' \
                   | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//' \
                   | grep . | sort -u)

  if printf '%s\n' "$declared_paths" | grep -q '[[:space:]]'; then
    echo "FATAL: 申报清单归一后仍有含空白的行,判为格式错(路径不许含空白),拒绝给出红/绿结论:" >&2
    printf '%s\n' "$declared_paths" | grep '[[:space:]]' | sed 's/^/  /' >&2
    exit 2
  fi

  # 申报行尾带 `# 裁决-N` 的路径:测试锁与越面(flow-close)的例外通道 —— 例外要有号,能追到裁决
  declared_verdict=$(grep -v '^[[:space:]]*#' "$declared" | LC_ALL=C grep -E '#[^#]*裁决[- ]*[0-9]+' \
                     | sed -e 's/^[0-9a-f]\{40,\}  //' -e 's/^git \(..\) //' -e 's/^git //' | sed 's/.* -> //' | sed 's/^[[:space:]]*//' \
                     | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//' | grep . | sort -u)

  red=0
  for p in $tracked $ig_changed; do
    printf '%s\n' "$declared_paths" | grep -qxF -- "$p" || { echo "RED 漏申报: $p —— 申报清单补这一行,或还原它(它确实被改了)"; red=1; }
  done
  for p in $ig_gone; do
    printf '%s\n' "$declared_paths" | grep -qxF -- "$p" || { echo "RED 漏申报(被删): $p —— 申报清单补这一行,或还原它"; red=1; }
  done

  # 轴3 测试锁(0.9.0):已有测试件动了要有裁决号;本轮改过 / 新增的测试件不许带跳过标记
  nlock=0; nlockok=0; nlocktxt=""
  if ! grep -q '^# test-lock ' "$base"; then
    echo "测试锁:基线无 test-lock 行(0.9.0 前打的),本次未核"; nlocktxt="未核(旧基线)"
  elif [ "$(sed -n 's/^# test-lock //p' "$base")" = 0 ] && [ -z "$(test_files)" ]; then
    echo "测试锁:仓内零测试件(FLOW_TEST_GLOBS=$FLOW_TEST_GLOBS)"; nlocktxt="零测试件"
  else
    tl=$(mktemp "$(flow_tmpdir)/flow-manifest.XXXXXX")
    sed -n 's/^test //p' "$base" | while IFS= read -r line; do
      h=${line%%  *}; p=${line#*  }
      if [ -f "$p" ]; then cur=$(flow_sha256 "$p"); cur=${cur%%  *}; else cur=gone; fi
      [ "$cur" = "$h" ] && continue
      if printf '%s\n' "$declared_verdict" | grep -qxF -- "$p"; then echo "ok   测试锁: $p 改动带裁决号(申报行)"
      else echo "RED 测试锁: $p 已有测试被$([ "$cur" = gone ] && echo 删 || echo 改),申报行无裁决号 —— 还原它,或申报行写成「$p  # 裁决-N <为什么改>」"; fi
    done > "$tl"
    cat "$tl"
    grep -q '^RED 测试锁' "$tl" && red=1
    nlock=$(grep -c '^test ' "$base" || true)
    nlockok=$(grep -c '^ok   测试锁' "$tl" || true)
    # 跳过 / 独跑标记:只扫本轮动过的测试件(棘轮:没动的不追溯),命中且申报行无裁决号 ⟹ RED
    test_files | while IFS= read -r p; do
      [ -f "$p" ] || continue
      bh=$(sed -n 's/^test //p' "$base" | LC_ALL=C awk -v p="$p" 'substr($0, length($0) - length(p) + 1) == p && substr($0, length($0) - length(p) - 1, 2) == "  " { print substr($0, 1, length($0) - length(p) - 2); exit }')
      cur=$(flow_sha256 "$p"); cur=${cur%%  *}
      [ "$bh" = "$cur" ] && continue
      hit=$(LC_ALL=C grep -nE "$FLOW_TEST_SKIP_RE" "$p" | head -3)
      [ -n "$hit" ] || continue
      if printf '%s\n' "$declared_verdict" | grep -qxF -- "$p"; then echo "ok   测试锁: $p 含跳过标记但申报行带裁决号"
      else echo "RED 测试锁: $p 含跳过 / 独跑标记(FLOW_TEST_SKIP_RE)—— 去掉它,或申报行写成「$p  # 裁决-N <为什么>」:"; printf '%s\n' "$hit" | sed 's/^/       /'; fi
    done > "$tl"
    cat "$tl"
    grep -q '^RED 测试锁' "$tl" && red=1
    rm -f "$tl"
    nlocktxt="$nlock 件($nlockok 件改动带裁决)"
  fi

  if [ "$red" = 0 ]; then
    echo "verify OK: 实改集(git $(printf '%s\n' $tracked | grep -c . || true) + ignored $(printf '%s\n' $ig_changed | grep -c . || true)) 全部在申报清单内 · 测试锁 $nlocktxt"
  fi
  exit $red
  ;;

*) flow_die "未知子命令: $cmd(只认 baseline|verify)" ;;
esac
