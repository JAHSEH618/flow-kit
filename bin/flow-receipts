#!/usr/bin/env bash
# flow-receipts —— 接收位覆盖枚举(「任务书声称已覆盖接收位」的探测器)。
# 任务书声称「已覆盖接收位」之前 / 复审核对之时,用本命令机械枚举后 diff 任务书 —— 漏一条当场可见。
# 两条轴(= spec 复核两轴的同款结构):
#   轴1 节内:该任务小节里的 接收位/强制条款/开口项 标记行
#   轴2 节外:整份 plan 里点名该任务的行 —— 别的节落给它的账(曾漏掉的那条正是归在别节的)
# 两种 plan 体例(FLOW_RECEIPT_MODE,默认 section):
#   section:任务 = `## <任务号>` 小节(轴1 = 节内标记行)
#   table  :任务 = 表行(轴1 = 以 `|` 开头且点名该任务号的行)—— ShipLedger 的 spec/P*.md 是这一种,
#            按 section 跑恒 FATAL,于是每轮编排方手核;体例是项目的事实,进 config 不进脚本。
# 用法: flow-receipts <plan文件(仓相对或绝对)> <任务号>
#   例: flow-receipts specs/plan/p2-engine.md P2-T7
# 仓根取自 FLOW_REPO_DIR(脚本自己 cd;plan 的相对路径以仓根为锚,不依赖调用方 cwd)。
# 末行固定:`RECEIPTS OK: 轴1 <N> · 轴2 <M>`;两轴都空 ⟹ FATAL RC=2(「全覆盖」与「没扫到」不许同型)。
# 读的配置:FLOW_REPO_DIR FLOW_RECEIPT_MODE
set -u
. "$(cd "$(dirname "$0")/.." && pwd)/lib/flow-lib.sh"
flow_load_config

[ $# -ge 2 ] || { echo "用法: flow-receipts <plan文件> <任务号,如 P2-T7>" >&2; exit 2; }
f="$1"; t="$2"
cd "$FLOW_REPO_DIR"
[ -f "$f" ] || flow_die "文件不存在 $f"
MODE="${FLOW_RECEIPT_MODE:-section}"
case "$MODE" in section|table) ;; *) flow_die "FLOW_RECEIPT_MODE 须为 section|table,得到:「$MODE」" ;; esac

if [ "$MODE" = table ]; then
  echo "## 轴1 · $t 的任务表行(体例 table;以 | 开头且点名 $t)"
  a1=$(awk -v t="$t" -v F="$f" '/^[[:space:]]*\|/ && index($0,t) {printf "%s:%d: %s\n", F, NR, substr($0,1,160)}' "$f")
  [ -n "$a1" ] && printf '%s\n' "$a1"
  n1=$(printf '%s' "$a1" | grep -c . || true)
  echo ""
  echo "## 轴2 · 非表行里点名 $t 的行(别处落给它的账)"
  a2=$(awk -v t="$t" -v F="$f" '!/^[[:space:]]*\|/ && index($0,t) {printf "%s:%d: %s\n", F, NR, substr($0,1,160)}' "$f")
  [ -n "$a2" ] && printf '%s\n' "$a2"
  n2=$(printf '%s' "$a2" | grep -c . || true)
else
  sec_start=$(grep -n "^## $t " "$f" | head -1 | cut -d: -f1)
  [ -n "$sec_start" ] || sec_start=$(grep -n "^## $t" "$f" | head -1 | cut -d: -f1)
  [ -n "$sec_start" ] || flow_die "找不到节 ## $t —— 若本仓的任务是表行不是小节,config 里设 FLOW_RECEIPT_MODE=table"
  sec_end=$(awk -v s="$sec_start" 'NR>s && /^## /{print NR-1; exit}' "$f")
  [ -n "$sec_end" ] || sec_end=$(wc -l < "$f" | tr -d ' ')

  echo "## 轴1 · $t 节内标记行(L$sec_start–$sec_end)"
  a1=$(awk -v s="$sec_start" -v e="$sec_end" -v F="$f" \
    'NR>=s && NR<=e && /接收位|强制条款|开口项/ {printf "%s:%d: %s\n", F, NR, substr($0,1,160)}' "$f")
  [ -n "$a1" ] && printf '%s\n' "$a1"
  n1=$(printf '%s' "$a1" | grep -c . || true)
  echo ""
  echo "## 轴2 · 节外点名 $t 的行(别的节落给它的账)"
  a2=$(awk -v s="$sec_start" -v e="$sec_end" -v t="$t" -v F="$f" \
    '(NR<s || NR>e) && index($0,t) {printf "%s:%d: %s\n", F, NR, substr($0,1,160)}' "$f")
  [ -n "$a2" ] && printf '%s\n' "$a2"
  n2=$(printf '%s' "$a2" | grep -c . || true)
fi

echo ""
if [ "$n1" -eq 0 ] && [ "$n2" -eq 0 ]; then
  echo "FATAL: 两轴都零命中(体例 $MODE)—— 「全覆盖」与「没扫到」不许同型;核对任务号写法或 FLOW_RECEIPT_MODE" >&2
  exit 2
fi
echo "RECEIPTS OK: 轴1 $n1 · 轴2 $n2(体例 $MODE)"
exit 0
