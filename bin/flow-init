#!/bin/sh
# flow-init —— 把 flow-kit 装进一个工作区(幂等:已有的不覆盖,逐项打印 已有/已写)。
# 用法: flow-init [--ws <工作区根(绝对;默认 cwd)>] [--repo <仓路径,相对工作区;默认 .>]
#                 [--ledger <账本路径,相对仓根;默认 specs/debts.md>] [--spec-dirs "<目录…>";默认 specs]
#                 [--untracked 0|1;默认自动:规格目录被 gitignore 则 1] [--main <主干分支;默认 master>]
#                 [--keep-plugins "<插件…>"] [--keep-mcp "<MCP 名…>"] [--dry-run]
# 做的事:.claude/flow.config.sh(模板填空)· .claude/flow-local.md · <流程目录>/ 与规则书棘轮起点 · 账本骨架(缺才建)
#         · 仓的 .git/hooks/post-commit shim(已有别的 hook 就追加一行,不覆盖)
#         · --keep-plugins 与 --keep-mcp 都给了才写 FLOW_KEEP_* 并跑 flow-settings --write(会话瘦身);没给就留提示,不猜
#         · 末尾跑 flow-config --check。
# 门命令(flow_gates)不代填 —— 门是项目的事实,留给人填;没填之前 flow-gates 会 FATAL,这是故意的。
set -u
KIT="$(cd "$(dirname "$0")/.." && pwd)"
. "$KIT/lib/flow-lib.sh"

WS="$(pwd)"; REPO="."; LEDGER="specs/debts.md"; SPEC_DIRS="specs"; UNTRACKED=""; MAIN="master"; DRY=0
KEEP_PLUGINS=""; KEEP_MCP=""; KEEP_PLUGINS_SET=0; KEEP_MCP_SET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ws) WS="${2:?}"; shift ;;
    --repo) REPO="${2:?}"; shift ;;
    --ledger) LEDGER="${2:?}"; shift ;;
    --spec-dirs) SPEC_DIRS="${2:?}"; shift ;;
    --untracked) UNTRACKED="${2:?}"; shift ;;
    --main) MAIN="${2:?}"; shift ;;
    --keep-plugins) KEEP_PLUGINS="${2?}"; KEEP_PLUGINS_SET=1; shift ;;
    --keep-mcp) KEEP_MCP="${2?}"; KEEP_MCP_SET=1; shift ;;
    --dry-run) DRY=1 ;;
    *) echo "用法见脚本头注" >&2; exit 2 ;;
  esac; shift
done
case "$WS" in /*) ;; *) flow_die "--ws 须绝对路径: $WS" ;; esac
case "$REPO" in /*) flow_die "--repo 须相对工作区,不许绝对路径: $REPO" ;; esac
[ -d "$WS" ] || flow_die "工作区不存在: $WS"
case "$REPO" in .) REPO_DIR="$WS" ;; *) REPO_DIR="$WS/$REPO" ;; esac
[ -d "$REPO_DIR/.git" ] || [ -f "$REPO_DIR/.git" ] || flow_die "不是 git 仓: $REPO_DIR"

# 自动判断规格目录是否被 gitignore(第一个存在的目录为准)
if [ -z "$UNTRACKED" ]; then
  UNTRACKED=0
  for d in $SPEC_DIRS; do
    if [ -d "$REPO_DIR/$d" ]; then
      if git -C "$REPO_DIR" check-ignore -q "$d" 2>/dev/null; then UNTRACKED=1; fi
      break
    fi
  done
fi

say() { printf '%s\n' "$*"; }
write_file() {  # $1 目标 $2 内容来源文件(已填空)
  if [ -f "$1" ]; then say "已有  $1(不覆盖)"; return 0; fi
  [ "$DRY" = 1 ] && { say "将写  $1"; return 0; }
  mkdir -p "$(dirname "$1")" && cp "$2" "$1" && say "已写  $1"
}

TMP=$(mktemp "$(flow_tmpdir)/flow-init.XXXXXX") || exit 2
trap 'rm -f "$TMP"' EXIT

# 1. config(FLOW_KEEP_* 只在两个 --keep-* 都给了才写成真实行;否则留注释占位,flow-settings 会 FATAL 并列候选)
if [ "$KEEP_PLUGINS_SET" = 1 ] && [ "$KEEP_MCP_SET" = 1 ]; then
  KP_LINE="FLOW_KEEP_PLUGINS=\"$KEEP_PLUGINS\""; KM_LINE="FLOW_KEEP_MCP=\"$KEEP_MCP\""
else
  KP_LINE='# FLOW_KEEP_PLUGINS=""                # 例:typescript-lsp claude-hud'; KM_LINE='# FLOW_KEEP_MCP=""                    # 例:exa'
fi
sed -e "s|@REPO@|$REPO|g" -e "s|@LEDGER@|$LEDGER|g" -e "s|@SPEC_DIRS@|$SPEC_DIRS|g" \
    -e "s|@UNTRACKED@|$UNTRACKED|g" -e "s|@MAIN@|$MAIN|g" \
    -e "s|@KEEP_PLUGINS_LINE@|$KP_LINE|" -e "s|@KEEP_MCP_LINE@|$KM_LINE|" "$KIT/lib/templates/flow.config.sh" > "$TMP"
write_file "$WS/.claude/flow.config.sh" "$TMP"

# 2. flow-local
write_file "$WS/.claude/flow-local.md" "$KIT/lib/templates/flow-local.md"

# 1b. 读已有(或刚写的)config,之后的流程目录名以它为准,不硬编码
FLOWDIR=".flow"
if [ -f "$WS/.claude/flow.config.sh" ]; then
  ( FLOW_CONFIG="$WS/.claude/flow.config.sh"; export FLOW_CONFIG; . "$KIT/lib/flow-lib.sh"; flow_load_config; printf '%s' "$FLOW_FLOW_DIR" ) > "$TMP.flowdir" 2>/dev/null && FLOWDIR=$(cat "$TMP.flowdir"); rm -f "$TMP.flowdir"
  [ -n "$FLOWDIR" ] || FLOWDIR=".flow"
fi

# 3. 流程目录 + 规则书棘轮起点(已有就不动;0.8.3 起量字节,旧 .rulebook-lines 由 flow-close 换单位)
if [ "$DRY" = 0 ]; then
  mkdir -p "$WS/$FLOWDIR"
  if [ ! -f "$WS/$FLOWDIR/.rulebook-bytes" ] && [ ! -f "$WS/$FLOWDIR/.rulebook-lines" ] && [ -f "$WS/.claude/flow-local.md" ]; then
    wc -c < "$WS/.claude/flow-local.md" | tr -d ' ' > "$WS/$FLOWDIR/.rulebook-bytes"
    say "已写  $WS/$FLOWDIR/.rulebook-bytes(规则书棘轮起点 = $(cat "$WS/$FLOWDIR/.rulebook-bytes") 字节)"
  else
    say "已有  $WS/$FLOWDIR/"
  fi
fi

# 4. 账本骨架
write_file "$REPO_DIR/$LEDGER" "$KIT/lib/templates/debts.md"

# 5. git shim
HOOK="$REPO_DIR/.git/hooks/post-commit"
ABS="$KIT/bin/flow-post-commit"
# 0.8.2:把**本树的物理路径**烙进 shim。快照是 rsync 副本(连 .git 一起),副本里有它自己的 config,
#   flow-post-commit 的「pwd == FLOW_REPO_DIR」守卫在副本里照样成立 —— 在快照里 commit 一笔基线就会改掉刚冻结的树。
#   烙死路径之后,副本 / worktree 上的 commit 静默跳过(hook 永不挡 commit)。
REPO_PHYS=$(cd "$REPO_DIR" && pwd -P)
if [ -f "$HOOK" ]; then
  if grep -q 'flow-post-commit' "$HOOK"; then
    if grep -qF "$REPO_PHYS" "$HOOK"; then
      say "已有  $HOOK(已含 flow-post-commit + 快照守卫)"
    elif grep -q 'flow-kit shim' "$HOOK"; then
      # 整份 hook 就是我们自己生成的 shim(有标记行),0.8.2 升级直接重写它 —— 不是别人的 hook,不必让人手改
      sed -e "s|@ABS@|$ABS|g" -e "s|@REPO@|$REPO_PHYS|g" "$KIT/lib/templates/post-commit.shim" > "$TMP"
      if [ "$DRY" = 1 ]; then say "将重写 $HOOK(旧 shim 无快照守卫,0.8.2 补上)"; else
        cp "$TMP" "$HOOK" && chmod +x "$HOOK" && say "已重写 $HOOK(旧 shim 无快照守卫,0.8.2 补上:pwd 不是 $REPO_PHYS 就静默退出)"
      fi
    else
      say "已有  $HOOK(是别人的 hook,里面追加过 flow-post-commit,但**没有快照守卫**)"
      say "      手工在那几行之前加一行:if [ \"\$(pwd -P)\" != \"$REPO_PHYS\" ]; then exit 0; fi"
      say "      为什么:变异轴的快照连 .git 一起拷,副本里 commit 一笔会把队列写进快照、改掉刚冻结的树"
    fi
  else
    if [ "$DRY" = 1 ]; then say "将追加 flow-post-commit 一行到已有 hook: $HOOK"; else
      printf '\n# flow-kit(flow-init 追加,不覆盖原 hook);快照守卫见 0.8.2:副本 / worktree 上静默跳过\nif [ "$(pwd -P)" = "%s" ]; then\n  if command -v flow-post-commit >/dev/null 2>&1; then flow-post-commit "$@"; elif [ -x "%s" ]; then "%s" "$@"; fi\nfi\n' "$REPO_PHYS" "$ABS" "$ABS" >> "$HOOK"
      say "已追加 $HOOK(原 hook 保留;若原 hook 提前 exit,追加行不会执行 —— 自己看一眼)"
    fi
  fi
else
  sed -e "s|@ABS@|$ABS|g" -e "s|@REPO@|$REPO_PHYS|g" "$KIT/lib/templates/post-commit.shim" > "$TMP"
  if [ "$DRY" = 1 ]; then say "将写  $HOOK"; else
    mkdir -p "$(dirname "$HOOK")" && cp "$TMP" "$HOOK" && chmod +x "$HOOK" && say "已写  $HOOK(shim)"
  fi
fi

# 5b. 单仓布局:流程目录与门缓存落在仓内,用 .git/info/exclude(本地,不入库)挡掉,免得 post-commit 把它们记成新目录
if [ "$REPO" = "." ] && [ "$DRY" = 0 ] && [ -d "$REPO_DIR/.git" ]; then
  EX="$REPO_DIR/.git/info/exclude"; mkdir -p "$(dirname "$EX")"; touch "$EX"
  for pat in "$FLOWDIR/" '.claude/flow-gates/' '.claude/map-debt.md' '.claude/fact-lint-baseline.tsv'; do
    grep -qxF "$pat" "$EX" || { printf '%s\n' "$pat" >> "$EX"; say "已加  $EX ← $pat"; }
  done
fi

# 5c. 会话瘦身:两个 --keep-* 都给了才动 settings.local.json;config 已有(不覆盖)时以 config 里的 FLOW_KEEP_* 为准
if [ "$KEEP_PLUGINS_SET" = 1 ] && [ "$KEEP_MCP_SET" = 1 ]; then
  if [ "$DRY" = 1 ]; then say "将跑  flow-settings --write(关掉 FLOW_KEEP_* 之外的插件与 MCP)"; else
    ( cd "$WS" && "$KIT/bin/flow-settings" --write ); rc=$?; [ "$rc" = 0 ] || flow_die "flow-settings --write RC=$rc"
  fi
else
  say "未瘦身:没同时给 --keep-plugins 与 --keep-mcp;之后在 config 填 FLOW_KEEP_PLUGINS / FLOW_KEEP_MCP 再跑 flow-settings --write"
fi

# 6. 核对
rc=0
if [ "$DRY" = 0 ]; then
  say "—— flow-config --check ——"
  ( cd "$WS" && "$KIT/bin/flow-config" --check ); rc=$?
  say "flow-config --check RC=$rc"
fi
say "下一步:在 $WS/.claude/flow.config.sh 填 flow_gates(门命令)与 FLOW_FACT_LINT_ROOTS;派单前读 /flow-kit:protocol。"
exit "$rc"
